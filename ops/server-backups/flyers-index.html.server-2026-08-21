<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fast Quote — Click Click Graphics</title>
<meta name="description" content="Instant print quote. Flyers, cards, posters. Brussels.">
<style>
/* GT Pressura — the Click Click brand face. Licensed webfont, self-hosted.
   Three real weights (300/400/700) plus italics, subsetted to Latin + Latin-Ext
   and the punctuation the shop and the legal pages use. Nothing is synthesised:
   the browser never has to fake a weight, which is what smears a typeface.
   Replaced Space Grotesk (Google Fonts) — see task #1. */
@font-face{font-family:'GT Pressura';font-style:normal;font-weight:300;font-display:swap;src:url(fonts/gt-pressura-300.woff2) format('woff2')}
@font-face{font-family:'GT Pressura';font-style:italic;font-weight:300;font-display:swap;src:url(fonts/gt-pressura-300-italic.woff2) format('woff2')}
@font-face{font-family:'GT Pressura';font-style:normal;font-weight:400;font-display:swap;src:url(fonts/gt-pressura-400.woff2) format('woff2')}
@font-face{font-family:'GT Pressura';font-style:italic;font-weight:400;font-display:swap;src:url(fonts/gt-pressura-400-italic.woff2) format('woff2')}
@font-face{font-family:'GT Pressura';font-style:normal;font-weight:700;font-display:swap;src:url(fonts/gt-pressura-700.woff2) format('woff2')}
@font-face{font-family:'GT Pressura';font-style:italic;font-weight:700;font-display:swap;src:url(fonts/gt-pressura-700-italic.woff2) format('woff2')}
</style>
<style>
  :root{
    --cream:#fff5ef;
    --cream-2:#fff5ef;
    --cream-3:#ffe5d4;
    --ink:#000000;
    --ink-2:#2a2a2a;
    --ink-dim:#4a4a4a;
    --ink-dimmer:#9a9287;
    --indigo:#4200ff;
    --indigo-dark:#3300c1;
    --indigo-hi:#5311ff;
    --line:#e6d6c3;
    --line-hi:#d4c2ab;
    --indigo-mute:#cdc0ff;   /* disabled buttons — a muted indigo, not the brown line colour */
    --indigo-mute-ink:#6a56cc;
    --red:#ef3226;
    --green:#19a26e;
  }
  *,*::before,*::after{box-sizing:border-box}
  html,body{margin:0;padding:0;background:var(--cream);color:var(--ink);font-family:'GT Pressura',system-ui,sans-serif;font-weight:400;-webkit-font-smoothing:antialiased}
  body{min-height:100vh;overflow-x:hidden}
  a{color:var(--ink);text-decoration:none}
  a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}
  em{font-style:italic}

  /* ─────── Top bar — full-bleed indigo, cream wordmark (tiegel.be) ───────
     The wordmark is TEXT, not logo.png: that PNG is an indigo mark on
     transparency, which disappears on an indigo bar. GT Pressura 700 with the
     "!" in italic reproduces it exactly, stays crisp at any zoom, and lets the
     mark step down on narrow screens instead of the nav wrapping to a second
     row. Same treatment as /papers/ and /legal/. */
  .topbar{background:var(--indigo);color:var(--cream);position:sticky;top:0;z-index:10}
  .topbar .inner{max-width:1280px;margin:0 auto;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:nowrap}
  .topbar a{color:var(--cream);text-decoration:none}
  .mark{font-weight:700;font-size:19px;letter-spacing:.02em;text-transform:uppercase;white-space:nowrap;flex:none}
  .mark em{font-style:italic}
  .mark .mk-min{display:none}
  nav.main{display:flex;gap:22px;align-items:center;font-size:15px;white-space:nowrap;flex:none}
  nav.main a{color:var(--cream);font-weight:400;font-size:15px}
  nav.main a.cur{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
  .langs{display:flex;gap:2px;background:rgba(255,245,239,.16);border-radius:999px;padding:3px}
  .langs button{background:transparent;border:0;color:var(--cream);opacity:.6;font:inherit;font-size:12px;font-weight:700;letter-spacing:.08em;padding:4px 10px;border-radius:999px;cursor:pointer;text-transform:uppercase}
  .langs button.on{background:var(--cream);color:var(--indigo);opacity:1}

  @media (max-width:460px){
    .mark .mk-short{display:none}
    .mark .mk-min{display:inline;font-size:20px}
    .topbar .inner{padding:10px 14px;gap:10px}
    .langs{padding:2px}
    .langs button{padding:3px 6px;font-size:10px;letter-spacing:.05em}
  }

  /* ─────── Shell ─────── */
  .shell{max-width:1280px;margin:0 auto;padding:14px 28px 120px}

  /* ─────── Hero (cream text on indigo) ─────── */
  /* Hero is a bounded blue BAND, not the page. tiegel.be alternates full-bleed
     colour blocks down the page; the blue reads as a section, and everything
     below it gets a quiet cream ground so the selected states and the Order
     button are the only blue left — which is what makes them carry. */
  /* Cream ground under an indigo bar — tiegel's arrangement. The bar only
     reads as a header if what sits below it is a different colour. */
  .hero-band{background:var(--cream);color:var(--ink)}
  .hero-inner{max-width:1280px;margin:0 auto;padding:34px 28px 18px}
  .hero{margin-bottom:0;max-width:1000px;color:var(--indigo)}
  .hero h1{font-weight:400;font-size:clamp(46px,7.5vw,92px);line-height:1;letter-spacing:0;margin:0 0 20px}
  .hero h1 em{font-style:italic;color:var(--indigo)}
  .hero h1 .bangs{display:inline-flex;align-items:center;gap:.04em;margin-left:.02em;vertical-align:baseline}
  .hero h1 .bangs svg{height:.92em;width:auto;color:currentColor}
  .hero p{font-size:17px;line-height:1.5;margin:0;max-width:620px;color:var(--ink);font-weight:400}
  /* Plain line, deliberately not a pill or a button — it is reassurance, not
     something to press. Replaces the orphaned .hero .badges rules, which had
     no markup using them at all. */
  .hero-note{margin:14px 0 0;font-size:14px;letter-spacing:.02em;color:var(--ink-dim);opacity:1}

  /* ─────── Grid ─────── */
  .grid{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:32px;align-items:start}
  @media (max-width:980px){.grid{grid-template-columns:1fr}}

  /* ─────── Steps (cream cards on indigo body) ─────── */
  .step{background:var(--cream);color:var(--ink);border: 1px solid var(--ink);border-radius:20px;padding:28px;margin-bottom:16px;box-shadow:5px 5px 0 var(--ink)}
  /* Rules above and below, heading in blue: tiegel.be's section-heading
     device. The bracket is what makes it read as that site. */
  /* Blue heading with the key word in black, bracketed by hairline rules —
     tiegel.be's section device, kept to a single line. */
  .step .head{display:flex;align-items:center;gap:14px;flex-wrap:wrap;
    border-top:1px solid var(--indigo);border-bottom:1px solid var(--indigo);
    padding:13px 0;margin:0 0 22px}
  .step .num{font-weight:400;font-size:15px;color:var(--ink);background:transparent;border:1px solid var(--ink);border-radius:999px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;flex:none}
  /* tiegel.be sets every heading at weight 400 with no tracking and lets size
     do the work — there is no bold anywhere on that site. Matching that voice
     here means a bigger, lighter heading rather than a smaller, heavier one. */
  .step h2{font-weight:400;font-size:29px;margin:0;letter-spacing:0;line-height:1;
    color:var(--indigo);text-transform:uppercase}
  .step h2 em{color:var(--ink);font-style:normal}
  .step .hint{color:var(--ink-dim);font-size:13px;margin-left:auto;font-weight:400}

  /* ─────── Product tiles ─────── */
  .products{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  @media (max-width:640px){.products{grid-template-columns:1fr}}
  .tile{background:var(--cream-2);border: 1px solid var(--ink);border-radius:14px;padding:14px;cursor:pointer;transition:all .15s;text-align:left;color:var(--ink);font-family:inherit;position:relative;display:flex;gap:12px;align-items:center}
  .tile:hover{background:var(--cream-3);transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--ink)}
  .tile.on{background:var(--indigo);color:var(--cream);box-shadow:4px 4px 0 var(--ink)}
  .tile .img{flex-shrink:0;width:72px;height:72px;border-radius:10px;background:var(--cream);overflow:hidden;border: 1px solid var(--ink)}
  .tile .img svg{width:100%;height:100%;display:block}
  .tile .body{min-width:0;flex:1}
  .tile h3{margin:0 0 2px;font-size:17px;font-weight:700;letter-spacing:-.01em}
  .tile p{margin:0 0 4px;font-size:12px;line-height:1.35;font-weight:400;color:var(--ink-dim)}
  .tile.on p{color:var(--cream)}
  .tile .tag{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-dim);font-weight:700}
  .tile.on .tag{color:var(--cream)}

  /* ─────── Quantity ─────── */
  .qty-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .qtys{display:contents}
  .qty{background:var(--cream-2);border: 1px solid var(--ink);border-radius:999px;padding:8px 16px;font:inherit;color:var(--ink);cursor:pointer;transition:all .1s;text-align:center;font-weight:700;font-size:15px;letter-spacing:-.01em;min-width:56px}
  .qty:hover{background:var(--cream-3);transform:translate(-1px,-1px);box-shadow:2px 2px 0 var(--ink)}
  .qty.on{background:var(--indigo);color:var(--cream);box-shadow:3px 3px 0 var(--ink)}
  .qty-custom{background:var(--cream-2);border: 1px solid var(--ink);border-radius:999px;padding:0 14px;font:inherit;color:var(--ink);text-align:center;font-weight:700;font-size:15px;letter-spacing:-.01em;width:88px;height:38px;outline:none;-moz-appearance:textfield}
  .qty-custom::-webkit-outer-spin-button,
  .qty-custom::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .qty-custom:focus{background:var(--cream-3)}
  .qty-custom::placeholder{color:var(--ink-dim);font-weight:400;font-size:13px}
  .qty-custom.on{background:var(--indigo);color:var(--cream);box-shadow:3px 3px 0 var(--ink)}
  .qty-custom.on::placeholder{color:rgba(255,245,239,.65)}

  .versions-wrap{display:inline-flex;align-items:center;gap:10px}
  .versions-label{font-size:11px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.12em}
  .versions-control{display:inline-flex;align-items:center;border: 1px solid var(--ink);border-radius:999px;background:var(--cream-2);overflow:hidden;height:38px}
  .versions-step{width:32px;height:100%;border:0;background:transparent;font:inherit;font-size:18px;font-weight:700;color:var(--ink);cursor:pointer;line-height:1}
  .versions-step:hover{background:var(--cream-3)}
  .versions-step:active{background:var(--indigo);color:var(--cream)}
  #versionsInput{width:36px;height:100%;border:0;background:transparent;text-align:center;font:inherit;font-size:15px;font-weight:700;color:var(--ink);outline:none;-moz-appearance:textfield;border-left: 1px solid var(--ink);border-right: 1px solid var(--ink)}
  #versionsInput::-webkit-outer-spin-button,#versionsInput::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .versions-total{margin-top:10px;font-size:13px;font-weight:400;color:var(--ink-dim);font-style:italic}
  .versions-total strong{color:var(--ink);font-style:normal}

  /* ─────── Specs ─────── */
  .specs{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  @media (max-width:640px){.specs{grid-template-columns:1fr}}
  .field label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--ink);margin-bottom:8px}
  .select{position:relative}
  .select select{appearance:none;width:100%;background:var(--cream-2);border: 1px solid var(--ink);border-radius:12px;padding:13px 36px 13px 14px;color:var(--ink);font:inherit;font-weight:400;font-size:14px;cursor:pointer}
  .select select:focus{outline:none;background:var(--cream-3)}
  .select::after{content:"▾";position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--ink);pointer-events:none;font-size:11px;font-weight:700}

  .toggle-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .toggle-row button{background:var(--cream-2);border: 1px solid var(--ink);border-radius:12px;padding:13px;color:var(--ink);font:inherit;font-size:14px;font-weight:400;cursor:pointer;transition:all .1s}
  .toggle-row button:hover{background:var(--cream-3)}
  .toggle-row button.on{background:var(--indigo);color:var(--cream);box-shadow:3px 3px 0 var(--ink)}

  .express{display:flex;align-items:center;gap:12px;background:var(--cream-2);border:2px dashed var(--ink);border-radius:12px;padding:14px;margin-top:16px;cursor:pointer;transition:background .15s;color:var(--ink)}
  .express:hover{background:var(--cream-3)}
  .express .bolt{width:32px;height:32px;border-radius:999px;background:var(--ink);color:#ffd60a;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700}
  .express .text{flex:1}
  .express .text strong{display:block;font-size:14px;font-weight:700}
  .express .text small{color:var(--ink-dim);font-size:12px;font-weight:400}
  .express input{accent-color:var(--indigo);width:18px;height:18px}

  /* ─────── Checkout ─────── */
  .checkout .row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
  @media (max-width:640px){.checkout .row{grid-template-columns:1fr}}
  .checkout .row-zip{grid-template-columns:140px 1fr}
  @media (max-width:640px){.checkout .row-zip{grid-template-columns:1fr 1fr}}
  .checkout input[type="email"],.checkout input[type="text"],.checkout input[type="tel"]{width:100%;background:var(--cream-2);border: 1px solid var(--ink);border-radius:12px;padding:13px 14px;color:var(--ink);font:inherit;font-weight:400;font-size:14px}
  .checkout input:focus{outline:none;background:var(--cream-3)}
  .checkout input::placeholder{color:var(--ink-dim)}
  .checkout .inline-check{display:flex;align-items:center;gap:10px;padding:10px 0;cursor:pointer;font-size:14px;font-weight:400;color:var(--ink)}
  .checkout .inline-check input{width:18px;height:18px;accent-color:var(--indigo);margin:0;flex-shrink:0}
  .checkout .section-label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--ink);margin:16px 0 8px}
  .checkout .conditional{overflow:hidden;transition:max-height .2s}
  .receipt-note{margin:12px 0 0;font-size:13px;line-height:1.5;color:var(--ink-dim);font-style:italic}
  .step .receipt-note{text-align:center}
  .checkout .deliver{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 10px}
  @media (max-width:640px){.checkout .deliver{grid-template-columns:1fr}}
  .deliver label{background:var(--cream-2);border: 1px solid var(--ink);border-radius:12px;padding:14px;cursor:pointer;display:flex;flex-direction:column;gap:4px;transition:background .1s;color:var(--ink)}
  .deliver label:hover{background:var(--cream-3)}
  .deliver label.on{background:var(--indigo);color:var(--cream);box-shadow:3px 3px 0 var(--ink)}
  .deliver label.on small{color:var(--cream)}
  .deliver label.disabled{opacity:.45;cursor:not-allowed;background:var(--cream-2)}
  .deliver label.disabled:hover{background:var(--cream-2)}
  .deliver strong{font-size:14px;font-weight:700}
  .deliver small{color:var(--ink-dim);font-size:13px;line-height:1.45;font-weight:400}
  .deliver input{display:none}

  /* ─────── Upload zone ─────── */
  .upload-zone{border:2px dashed var(--ink);border-radius:14px;padding:28px 20px;text-align:center;cursor:pointer;background:var(--cream-2);transition:background .15s,border-color .15s,transform .1s}
  .upload-zone:hover,.upload-zone:focus,.upload-zone.dragover{background:var(--cream-3);outline:none;transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--ink)}
  .upload-zone.uploading,.upload-zone.done{cursor:default;border-style:solid}
  .upload-zone.done{background:#ecfdf5;border-color:#10b981}
  .upload-zone.error{background:#fef2f2;border-color:#dc2626}
  .upload-prompt{margin:0 0 6px;font-size:14px;font-weight:400;color:var(--ink)}
  .upload-hint{margin:0;font-size:12px;color:var(--ink-dim);font-weight:400}
  .upload-status{margin-top:10px;font-size:13px;line-height:1.5}
  .upload-status:empty{display:none}
  .upload-progress{color:var(--ink);font-weight:400}
  .upload-bar{margin-top:6px;height:6px;border-radius:3px;background:var(--cream-3);overflow:hidden;border: 1px solid var(--ink)}
  .upload-bar span{display:block;height:100%;background:var(--indigo);transition:width .15s}
  .upload-list{list-style:none;margin:0 0 8px;padding:0;display:flex;flex-direction:column;gap:6px}
  .upload-item{display:flex;align-items:center;gap:10px;background:#ecfdf5;border: 1px solid #6ee7b7;border-radius:10px;padding:8px 12px;color:#065f46;font-weight:400}
  .upload-item .file{flex:1;min-width:0;font-family:monospace;font-size:12px;word-break:break-all}
  .upload-item .size{font-size:11px;color:#065f46;opacity:.7;font-family:monospace;flex-shrink:0}
  .upload-remove{background:transparent;border: 1px solid #065f46;color:#065f46;padding:4px 10px;border-radius:8px;font:inherit;font-size:12px;font-weight:400;cursor:pointer;flex-shrink:0}
  .upload-remove:hover{background:#065f46;color:#ecfdf5}
  .upload-error{color:#991b1b;font-weight:400}

  /* ─────── Price / cart card (inverted: cream card with ink text, stands out on indigo) ─────── */
  /* Peach block — the third colour in tiegel.be's rhythm. Marks the quote as
     a distinct area on the cream page without introducing more blue. */
  .price-card{position:sticky;top:92px;background:var(--cream-3);color:var(--ink);border: 1px solid var(--ink);border-radius:20px;padding:28px;box-shadow:6px 6px 0 var(--ink);overflow:hidden}
  .price-card h3{font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:var(--ink-dim);margin:0 0 14px}
  /* Order header — the indigo bleed-to-edge band at the top of the sticky
     card. It used to show the live price for the item being configured, but
     that only ever described the CURRENT selection: once a second item was
     added it read as though it were the total, which it never was. The single
     live price now lives on the Add-to-order button, and the running total is
     in .totals below, where it belongs. */
  .price-card .order-head{background:var(--indigo);color:var(--cream);margin:-28px -28px 18px;padding:14px 24px;border-bottom: 1px solid var(--ink);text-align:center;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.14em}
  /* VAT note rides on the same line, in brackets. */
  .price-card .order-head .vat{font-weight:400;letter-spacing:.06em}
  .price-card .order-head .vat::before{content:'('}
  .price-card .order-head .vat::after{content:')'}

  /* ─────── Cart items ─────── */
  .cart-items{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-direction:column;gap:8px}
  .cart-items:empty{display:none}
  .cart-item{background:var(--cream-2);border: 1px solid var(--ink);border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;gap:6px}
  .cart-item.editing{background:#fff7e6;border-color:#f59e0b;outline:2px dashed #f59e0b;outline-offset:-2px}
  .cart-item .ci-top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
  .cart-item .ci-title{font-weight:700;font-size:14px;color:var(--ink);letter-spacing:-.01em;flex:1;min-width:0}
  .cart-item .ci-price{font-weight:700;font-size:14px;color:var(--indigo);white-space:nowrap}
  .cart-item .ci-price.pending{color:var(--ink-dim);font-weight:400}
  .cart-item .ci-meta{font-size:12px;color:var(--ink-dim);font-weight:400;line-height:1.4}
  .cart-item .ci-files{font-size:11px;font-weight:400;color:#065f46;background:#ecfdf5;border: 1px solid #6ee7b7;border-radius:6px;padding:2px 6px;display:inline-block;margin-top:2px}
  .cart-item .ci-files.missing{color:#991b1b;background:#fef2f2;border-color:#fca5a5}
  .cart-item .ci-actions{display:flex;gap:6px;margin-top:2px}
  .cart-item .ci-btn{background:transparent;border: 1px solid var(--ink);border-radius:8px;padding:4px 10px;font:inherit;font-size:11px;font-weight:700;cursor:pointer;color:var(--ink);letter-spacing:.04em;text-transform:uppercase}
  .cart-item .ci-btn:hover{background:var(--cream-3)}
  .cart-item .ci-btn.remove{border-color:var(--red);color:var(--red)}
  .cart-item .ci-btn.remove:hover{background:var(--red);color:var(--cream)}
  .cart-empty{font-size:13px;color:var(--ink-dim);font-style:italic;padding:14px 0;text-align:center;border-top:1.5px dashed var(--line);border-bottom:1.5px dashed var(--line);margin-bottom:14px;white-space:pre-line}
  .cart-items:not(:empty) ~ .cart-empty{display:none}

  /* ─────── Totals ─────── */
  [hidden]{display:none !important}
  .totals{padding:12px 0;border-top: 1px solid var(--line);border-bottom: 1px solid var(--line);margin-bottom:14px;display:flex;flex-direction:column;gap:4px}
  .totals .trow{display:flex;justify-content:space-between;font-size:13px;color:var(--ink-dim);font-weight:400;gap:8px}
  .totals .trow .v{font-weight:700;color:var(--ink)}
  .totals .trow.total{font-size:16px;border-top: 1px solid var(--line);padding-top:8px;margin-top:4px}
  .totals .trow.total .k{color:var(--ink);font-weight:700;text-transform:uppercase;font-size:11px;letter-spacing:.12em;align-self:center}
  .totals .trow.total .v{color:var(--indigo);font-size:22px;letter-spacing:-.02em}
  .totals .trow.ex{font-size:11px;color:var(--ink-dimmer)}
  .totals .trow.ex .v{font-weight:400;color:var(--ink-dim)}

  .ready{display:flex;align-items:center;padding:10px 14px;background:var(--cream-3);border: 1px solid var(--ink);border-radius:10px;font-size:12px;font-weight:400;color:var(--ink);margin-bottom:14px}
  .ready .d{color:var(--ink-dim);line-height:1.35}
  .ready strong{color:var(--ink);font-weight:700;display:block;font-size:16px;letter-spacing:-.01em;margin-bottom:1px}

  /* ─────── Add to order CTA in configurator ─────── */
  .btn-add{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;margin-top:16px;background:var(--indigo);color:var(--cream);border: 1px solid var(--ink);border-radius:999px;padding:4px 4px 4px 22px;font:inherit;font-size:15px;font-weight:700;cursor:pointer;transition:transform .1s;text-transform:uppercase;letter-spacing:.03em}
  .btn-add:not(:disabled):hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--ink);background:var(--indigo-hi)}
  .btn-add:disabled{background:var(--indigo-mute);color:var(--indigo-mute-ink);cursor:not-allowed;border-color:var(--ink);font-size:13px}
  .btn-add:disabled:hover{transform:none;box-shadow:none;background:var(--indigo-mute)}
  .btn-add .lbl{flex:1;text-align:left}
  /* Amount stays prominent regardless of the button's enabled/disabled state —
     the price is the most important thing in the artwork step, the customer
     should always see it clearly even before they upload a file. Since the
     top-of-card banner stopped showing a price, this is the ONLY live price
     for the current selection, so it carries more weight than before. */
  .btn-add .amt{font-weight:700;font-size:26px;letter-spacing:-.01em;text-transform:none;opacity:1}
  .btn-add:disabled .amt{color:var(--ink);font-size:26px;opacity:1}
  .btn-add .ico{width:40px;height:40px;flex-shrink:0;border-radius:999px;background:var(--cream);color:var(--indigo);border: 1px solid var(--ink);display:flex;align-items:center;justify-content:center;font-size:22px;line-height:1;font-weight:700}
  .btn-add:disabled .ico{background:var(--cream-2);color:var(--ink-dim)}
  .add-hint{font-size:12px;color:var(--ink-dim);margin:8px 0 0;text-align:center;font-weight:400;font-style:italic}

  /* ─────── Editing pill ─────── */
  .editing-pill{background:#f59e0b;color:#0a0a0a;border: 1px solid var(--ink);border-radius:999px;padding:3px 10px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-left:auto}

  .btn-order{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;margin-top:20px;background:var(--indigo);color:var(--cream);border: 1px solid var(--ink);border-radius:999px;padding:4px 4px 4px 22px;font:inherit;font-size:15px;font-weight:700;cursor:pointer;transition:transform .1s;text-transform:uppercase;letter-spacing:.03em}
  .legal-notice{margin:16px 0 0;font-size:12px;line-height:1.5;color:var(--ink-dim);text-align:center}
  .legal-notice a{color:var(--indigo);text-decoration:underline;text-underline-offset:2px;white-space:nowrap}
  footer .privacy a{color:inherit;text-decoration:underline;text-underline-offset:2px}
  .btn-order:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--ink);background:var(--indigo-hi)}
  #custCountry{width:100%;font:inherit;font-size:15px;padding:11px 12px;border: 1px solid var(--ink);border-radius:10px;background:var(--cream);color:var(--ink);appearance:none}
  .paper-help{display:inline-block;margin:7px 0 0;font-size:12.5px;color:var(--indigo);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
  .paper-warn{margin:6px 0 0;font-size:12.5px;line-height:1.4;color:#8a3b12;background:#fdf1e7;border: 1px solid #e8c3a6;border-radius:8px;padding:7px 10px}
  .quote-box{margin-top:20px;padding:16px 18px;border: 1px solid var(--ink);border-radius:14px;background:var(--cream-2)}
  .quote-box strong{display:block;font-size:15px;margin-bottom:6px}
  .quote-box p{margin:0 0 12px;font-size:13.5px;line-height:1.5;color:var(--ink-dim)}
  .quote-box .quote-msg{margin:10px 0 0;font-weight:400;color:var(--ink)}
  .btn-quote{font:inherit;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;background:var(--indigo);color:var(--cream);border: 1px solid var(--ink);border-radius:999px;padding:10px 20px;cursor:pointer}
  .btn-quote:hover{background:var(--indigo-hi);transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--ink)}
  .btn-quote.disabled{background:var(--indigo-mute);color:var(--indigo-mute-ink);cursor:not-allowed;transform:none;box-shadow:none}
  .btn-order.disabled{background:var(--indigo-mute);color:var(--indigo-mute-ink);cursor:not-allowed;font-size:13px}
  .btn-order.disabled:hover{transform:none;box-shadow:none;background:var(--indigo-mute)}
  .btn-order .cart{width:40px;height:40px;border-radius:999px;background:var(--cream);color:var(--indigo);border: 1px solid var(--ink);display:flex;align-items:center;justify-content:center;font-size:18px}
  .btn-order.disabled .cart{background:var(--cream-2);color:var(--ink-dim)}
  .secure{text-align:center;margin-top:12px;font-size:11px;color:var(--ink-dim);font-weight:400;letter-spacing:.05em}

  /* ─────── Bespoke ─────── */
  .bespoke{margin-top:32px;padding:24px;background:var(--cream);color:var(--ink);border:2px dashed var(--ink);border-radius:20px;display:flex;align-items:center;gap:20px}
  @media (max-width:640px){.bespoke{flex-direction:column;text-align:center}}
  .bespoke .emoji{width:80px;height:auto;flex-shrink:0;display:block}
  .bespoke h4{margin:0 0 4px;font-weight:700;font-size:17px}
  .bespoke h4 em{color:var(--indigo)}
  .bespoke p{margin:0;color:var(--ink-dim);font-size:14px;font-weight:400}
  .bespoke a.mail{display:inline-flex;align-items:center;line-height:0;transition:transform .12s ease}
  .bespoke a.mail:hover{transform:scale(1.08)}
  .bespoke a.mail img{display:block}

  /* ─────── Footer (cream-ish on indigo) ─────── */
  footer{margin-top:56px;padding:28px 0 0;border-top: 1px solid var(--line-hi);color:var(--ink-dim);font-size:13px;line-height:1.6}
  footer .privacy{color:var(--ink-dim);font-weight:400}
  footer .privacy::before{content:"● ";color:var(--green)}

  /* ─────── Mobile compaction ─────── */
  @media (max-width:720px){
    .topbar .inner{padding:10px 16px;gap:12px}
      /* The bar must never wrap. Instead of the nav dropping to a second row,
         the wordmark steps down: full -> "CL!CK CL!CK" -> the bare "!!" mark. */
      .mark{font-size:15px}
      .mark .mk-long{display:none}
    nav.main{gap:16px}
    nav.main a{font-size:13px}
    nav.main a[href="#"]:not(.cur){display:none}
    .langs button{font-size:11px;padding:4px 8px}

    .shell{padding:12px 16px 40px}
    .hero{margin-bottom:24px}
    .hero h1{font-size:38px;line-height:1.02;margin-bottom:12px}
    .hero p{font-size:14px;line-height:1.45}
    .hero .arrow{margin-top:14px;font-size:36px;text-shadow:2px 2px 0 var(--ink)}

    .grid{gap:14px}

    .step{padding:16px;border-radius:16px;margin-bottom:10px;box-shadow:3px 3px 0 var(--ink)}
    .step .head{margin-bottom:12px;gap:10px}
    .step h2{font-size:17px}
    .step .num{font-size:12px;width:24px;height:24px}
    .step .hint{font-size:11px;flex-basis:100%;margin-left:0}

    .products{gap:8px}
    .tile{padding:10px;gap:10px;border-radius:12px}
    .tile .img{width:52px;height:52px;border-radius:8px}
    .tile h3{font-size:15px}
    .tile p{font-size:11px;line-height:1.3}
    .tile .tag{font-size:10px}

    .qty-row{gap:6px}
    .qty{padding:6px 12px;font-size:13px;min-width:44px}

    .specs{gap:10px}
    .field label{font-size:10px;margin-bottom:5px}
    .select select,.toggle-row button,.checkout input[type="email"],.checkout input[type="text"]{padding:10px 12px;font-size:13px;border-radius:10px}
    .select select{padding-right:32px}

    .express{padding:10px;margin-top:10px;gap:10px}
    .express .bolt{width:28px;height:28px;font-size:14px}
    .express .text strong{font-size:13px}
    .express .text small{font-size:11px}

    .checkout .row{gap:8px;margin-bottom:8px}
    .checkout .deliver{margin:10px 0;gap:6px}
    .deliver label{padding:10px}
    .deliver strong{font-size:13px}
    .deliver small{font-size:12px;line-height:1.4}

    .price-card{padding:18px;border-radius:16px;box-shadow:4px 4px 0 var(--ink);position:static;top:auto}
    .price-card h3{margin-bottom:10px;font-size:11px}
    .price-card .order-head{margin:-18px -18px 14px;padding:12px 16px;font-size:11px;letter-spacing:.12em}
    .cart-item{padding:8px 10px}
    .cart-item .ci-title{font-size:13px}
    .cart-item .ci-price{font-size:13px}
    .cart-item .ci-meta{font-size:11px}
    .totals .trow{font-size:12px}
    .totals .trow.total .v{font-size:18px}
    .btn-add{padding:12px;font-size:14px;margin-top:12px}
    .btn-add .amt,.btn-add:disabled .amt{font-size:22px}
    .btn-order{padding:3px 3px 3px 18px;font-size:14px;margin-top:14px}
    .btn-order .cart{width:34px;height:34px;font-size:15px}
    .secure{font-size:10px;margin-top:10px}

    .bespoke{margin-top:20px;padding:16px;gap:12px;border-radius:16px}
    .bespoke .emoji{width:60px}
    .bespoke h4{font-size:15px}
    .bespoke p{font-size:12px}
    .bespoke a.mail{padding:10px 16px;font-size:13px}

    footer{margin-top:28px;padding-top:18px;font-size:11px;gap:8px}
  }
</style>
</head>
<body>

<header class="topbar">
  <div class="inner">
    <a href="https://tiegel.be/" class="mark" aria-label="Click Click Graphics"><span class="mk-short">Cl<em>!</em>ck Cl<em>!</em>ck</span><span class="mk-long"> Graphics</span><span class="mk-min"><em>!!</em></span></a>
    <nav class="main">
      <a id="navServices" href="https://tiegel.be/" data-i18n="nav.services">Services</a>
      <a class="cur" href="/flyers/" data-i18n="nav.shop">Shop</a>
      <a id="navPaper" href="/papers/" data-i18n="nav.paper">Paper</a>
      <a id="navTerms" href="/legal/" data-i18n="nav.terms">Terms</a>
      <div class="langs" role="tablist">
        <button data-lang="en" class="on">EN</button>
        <button data-lang="fr">FR</button>
        <button data-lang="nl">NL</button>
      </div>
    </nav>
  </div>
</header>

<section class="hero-band">
  <div class="hero-inner">
    <section class="hero">
    <h1><span data-i18n="hero.title">Print quote in a</span> <em data-i18n="hero.seconds">Click</em></h1>
    <p data-i18n="hero.tagline">Brussels print shop. Real prices — pay online — pick up or we deliver by bike in Brussels.</p>
    <p class="hero-note" data-i18n="hero.note">No account needed</p>
    </section>
  </div>
</section>

<div class="shell">

  <main class="grid">

    <section class="flow">

      <!-- 01 Product -->
      <div class="step">
        <div class="head">
          <span class="num">1</span>
          <h2><span data-i18n="step1.title">What do you want to</span> <em data-i18n="step1.titleEm">print?</em></h2>
        </div>
        <div class="products" role="radiogroup">

          <button class="tile on" data-p="flyer">
            <div class="img">
              <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                <rect width="80" height="80" fill="#fef3ea"/>
                <g transform="translate(18 12) rotate(-8)">
                  <rect width="38" height="54" rx="2" fill="#eedfc8"/>
                </g>
                <g transform="translate(24 10) rotate(-3)">
                  <rect width="38" height="54" rx="2" fill="#f7e9dc" stroke="#0a0a0a" stroke-width="1"/>
                </g>
                <g transform="translate(30 8)">
                  <rect width="38" height="54" rx="2" fill="#fef3ea" stroke="#0a0a0a" stroke-width="1.5"/>
                  <rect x="4" y="6" width="30" height="12" fill="#3211fc"/>
                  <rect x="4" y="22" width="22" height="2" fill="#0a0a0a"/>
                  <rect x="4" y="27" width="26" height="2" fill="#0a0a0a"/>
                  <rect x="4" y="32" width="18" height="2" fill="#0a0a0a"/>
                  <circle cx="28" cy="44" r="6" fill="#ef3226"/>
                </g>
              </svg>
            </div>
            <div class="body">
              <h3 data-i18n="tile.flyer">Flyer</h3>
              <p data-i18n="tile.flyer.desc">Party, event, pop-up.</p>
              <span class="tag">A6 · A5</span>
            </div>
          </button>

          <button class="tile" data-p="card">
            <div class="img">
              <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                <rect width="80" height="80" fill="#fef3ea"/>
                <g transform="translate(8 28) rotate(-10)">
                  <rect width="50" height="32" rx="3" fill="#eedfc8"/>
                </g>
                <g transform="translate(16 26) rotate(-4)">
                  <rect width="50" height="32" rx="3" fill="#f7e9dc" stroke="#0a0a0a" stroke-width="1"/>
                </g>
                <g transform="translate(22 24)">
                  <rect width="50" height="32" rx="3" fill="#fef3ea" stroke="#0a0a0a" stroke-width="1.5"/>
                  <circle cx="11" cy="13" r="5" fill="#ef3226"/>
                  <rect x="20" y="10" width="24" height="2" fill="#0a0a0a"/>
                  <rect x="20" y="15" width="18" height="2" fill="#0a0a0a" opacity=".5"/>
                  <rect x="6" y="22" width="22" height="1.5" fill="#0a0a0a" opacity=".6"/>
                  <rect x="6" y="26" width="28" height="1.5" fill="#0a0a0a" opacity=".6"/>
                </g>
              </svg>
            </div>
            <div class="body">
              <h3 data-i18n="tile.card">Card</h3>
              <p data-i18n="tile.card.desc">Business, wedding, invite.</p>
              <span class="tag">BC · A7 · A6 · A5 · A4</span>
            </div>
          </button>

          <button class="tile" data-p="poster">
            <div class="img">
              <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                <rect width="80" height="80" fill="#fef3ea"/>
                <g transform="translate(28 10)">
                  <rect width="30" height="60" rx="1" fill="#fef3ea" stroke="#0a0a0a" stroke-width="1.5"/>
                  <rect width="30" height="28" fill="#3211fc"/>
                  <circle cx="15" cy="14" r="8" fill="#fef3ea"/>
                  <rect x="5" y="36" width="20" height="3" fill="#0a0a0a"/>
                  <rect x="5" y="43" width="16" height="2" fill="#0a0a0a" opacity=".6"/>
                  <rect x="5" y="48" width="18" height="2" fill="#0a0a0a" opacity=".6"/>
                  <rect x="5" y="55" width="12" height="2.5" fill="#ef3226"/>
                </g>
                <circle cx="43" cy="11" r="2.5" fill="#ef3226"/>
              </svg>
            </div>
            <div class="body">
              <h3 data-i18n="tile.poster">Poster</h3>
              <p data-i18n="tile.poster.desc">Festival, gallery, club.</p>
              <span class="tag" data-i18n="tile.poster.tag">A4 · A3 · larger on request</span>
            </div>
          </button>

        </div>
      </div>

      <!-- 02 Quantity -->
      <div class="step">
        <div class="head">
          <span class="num">2</span>
          <h2><span data-i18n="step2.title">How many</span> <em data-i18n="step2.titleEm">copies?</em></h2>
        </div>
        <div class="qty-row">
          <div class="qtys" id="qtyGroup"></div>
          <input type="number" id="customQty" class="qty-custom"
                 min="1" max="10000" step="1" inputmode="numeric"
                 placeholder="Andere" aria-label="Custom quantity">
          <div class="versions-wrap">
            <span class="versions-label" data-i18n="versions.label">Versions</span>
            <div class="versions-control">
              <button type="button" class="versions-step" id="versionsDec" aria-label="−">−</button>
              <input type="number" id="versionsInput" min="1" max="10" value="1" inputmode="numeric">
              <button type="button" class="versions-step" id="versionsInc" aria-label="+">+</button>
            </div>
          </div>
        </div>
        <div class="versions-total" id="versionsTotal" hidden></div>
      </div>

      <!-- 03 Specs -->
      <div class="step">
        <div class="head">
          <span class="num">3</span>
          <h2><span data-i18n="step3.title">Size &amp;</span> <em data-i18n="step3.titleEm">paper</em></h2>
        </div>
        <div class="specs">
          <div class="field">
            <label data-i18n="label.size">Size</label>
            <div class="select"><select id="sizeSelect"></select></div>
          </div>
          <div class="field">
            <label data-i18n="label.paper">Paper</label>
            <div class="select"><select id="paperSelect"></select></div>
            <p class="paper-warn" id="paperWarn" hidden data-i18n="paper.prefillMissing">The paper from your quote isn’t available for this product — please check your choice below.</p>
            <a class="paper-help" id="paperHelp" href="/papers/" target="_blank" rel="noopener" data-i18n="paper.help">Explain the different papers →</a>
          </div>
          <div class="field" style="grid-column:1/-1">
            <label data-i18n="label.sides">Print sides</label>
            <div class="toggle-row" id="sidesGroup">
              <button class="on" data-sides="1" data-i18n="sides.recto">Recto only</button>
              <button data-sides="2" data-i18n="sides.rectoVerso">Recto &amp; Verso</button>
            </div>
          </div>
        </div>
        <label class="express">
          <input type="checkbox" id="expressChk">
          <div class="bolt">⚡</div>
          <div class="text">
            <strong data-i18n="express.title">Express · ready in 48 hours</strong>
            <small data-i18n="express.sub">+35% — for when you needed it yesterday</small>
          </div>
        </label>
      </div>

      <!-- 04 Upload artwork + rules -->
      <div class="step">
        <div class="head">
          <span class="num">4</span>
          <h2><span data-i18n="step5.title">Upload your</span> <em data-i18n="step5.titleEm">artwork</em></h2>
          <span class="editing-pill" id="editingPill" hidden><span data-i18n="cart.editingThis">Editing item</span></span>
        </div>
        <div class="upload-zone" id="uploadZone" tabindex="0" role="button" aria-label="Upload artwork">
          <input type="file" id="fileInput" accept=".pdf,.jpg,.jpeg,.png,.tiff,.tif" multiple hidden>
          <p class="upload-prompt" data-i18n="upload.drop">Drag your file here, or click to browse</p>
          <p class="upload-hint" data-i18n="upload.types">PDF, JPG, PNG, TIFF — max 100 MB</p>
        </div>
        <div id="uploadStatus" class="upload-status" aria-live="polite"></div>
        <p class="receipt-note" data-i18n="rules.bleed">⊞ Please add 3 mm bleed to your files so your print gets a perfect cut.</p>
        <button type="button" class="btn-add" id="btnAdd" disabled>
          <span class="lbl" id="btnAddLbl" data-i18n="cart.add">Add to order</span>
          <span class="amt" id="btnAddAmt"></span>
          <span class="ico" aria-hidden="true">+</span>
        </button>
        <p class="add-hint" id="addHint" data-i18n="cart.addHint">Configure the product, upload artwork, then add it. Repeat for more items.</p>
      </div>

      <!-- 05 Your details -->
      <div class="step checkout">
        <div class="head">
          <span class="num">5</span>
          <h2><span data-i18n="step4.title">Your</span> <em data-i18n="step4.titleEm">details</em></h2>
        </div>

        <div class="row">
          <input type="email" id="custEmail" data-i18n-placeholder="ph.email" placeholder="Email" required>
          <input type="text" id="custName" data-i18n-placeholder="ph.name" placeholder="Full name" required>
        </div>
        <div class="row">
          <input type="tel" id="custPhone" data-i18n-placeholder="ph.phone" placeholder="Phone (optional)">
        </div>

        <label class="inline-check">
          <input type="checkbox" id="isCompany">
          <span data-i18n="form.isCompany">This order is for a company</span>
        </label>

        <div class="conditional" id="companyBlock" hidden>
          <div class="row">
            <input type="text" id="custCompany" data-i18n-placeholder="ph.company" placeholder="Company name">
            <input type="text" id="vatNumber" data-i18n-placeholder="ph.vat" placeholder="VAT number — e.g. BE0732.984.161">
          </div>
        </div>

        <label class="section-label" data-i18n="label.address">Address</label>
        <div class="row">
          <input type="text" id="custAddress" data-i18n-placeholder="ph.street" placeholder="Street + number" required>
        </div>
        <div class="row row-zip">
          <input type="text" id="custZip" data-i18n-placeholder="ph.zip" placeholder="Zip">
          <input type="text" id="custCity" data-i18n-placeholder="ph.city" placeholder="City" required>
        </div>
        <div class="row">
          <select id="custCountry">
            <option value="BE" selected data-i18n="country.BE">Belgium</option>
            <option value="NL" data-i18n="country.NL">Netherlands</option>
            <option value="FR" data-i18n="country.FR">France</option>
            <option value="DE" data-i18n="country.DE">Germany</option>
            <option value="LU" data-i18n="country.LU">Luxembourg</option>
            <option value="OTHER" data-i18n="country.other">Another country</option>
          </select>
        </div>

        <label class="section-label" data-i18n="label.delivery">Delivery</label>
        <div class="deliver">
          <label class="on">
            <input type="radio" name="del" checked>
            <strong data-i18n="deliver.pickup">Pick-up — Free</strong>
            <small data-i18n="deliver.pickupSub">Aalststraat 7-11, 1000 Brussels · Mon–Fri 9–12:30 &amp; 14–18h</small>
          </label>
          <label>
            <input type="radio" name="del">
