  // ─── Express + delivery are ORDER-LEVEL (apply to the whole cart) ────────
  // DPD is blocked two ways: express (can't make 48 h) and any country other
  // than Belgium (the €15 flat is Belgium-only — those go through quote.php).
  function applyExpressDeliveryLock() {
    const labels = document.querySelectorAll('.deliver label');
    if (labels.length < 2) return;
    const abroad  = state.country !== 'BE';
    const blocked = state.express || abroad;
    labels[1].classList.toggle('disabled', blocked);
