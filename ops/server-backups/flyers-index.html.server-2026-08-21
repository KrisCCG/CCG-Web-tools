</div>

<script type="module">
  import { t, setLang, getLang, initLang, onLangChange } from './lib/i18n.js';

  // Prices come from the server — the client never sees raw costs or the formula.
  // Uses same-origin in production; falls back to the live endpoint for local dev.
  //
  // Auto-detects the backend folder from the page URL so side-by-side deployments
  // can coexist:  /flyers/    → /calculator/    (production)
  //               /flyers-v2/ → /calculator-v2/ (test site)
  //               /flyers-anything/ → /calculator-anything/
  const CALC_DIR = '/calculator' +
    ((location.pathname.match(/^\/flyers([^\/?#]*)/i) || [, ''])[1]);

  const CALC_URL = (location.hostname === 'localhost' || location.hostname.startsWith('127.'))
    ? 'https://clickclick.be/calculator/calc.php'
    : `${CALC_DIR}/calc.php`;

  const PRODUCTS = {
    flyer: {
      label: 'Flyer',
      sizes: [
        {k:'A6', v:'A6 · 105×148 mm', mult:1.0},
        {k:'A5', v:'A5 · 148×210 mm', mult:1.7},
      ],
      papers: [
        {k:'ms115', v:'MultiArt Silk · 115 gsm'},
        {k:'ms130', v:'MultiArt Silk · 130 gsm'},
        {k:'ms170', v:'MultiArt Silk · 170 gsm'},
        {k:'bt120', v:'Biotop · 120 gsm'},
        {k:'bt160', v:'Biotop · 160 gsm'},
        {k:'rs135', v:'Recystar · 135 gsm'},
      ],
      // Index 1 = ms130. New stocks are appended so this stays put.
      defaultPaperIdx: 1,
      qtys: [250, 500, 1000, 2500],
      hint: "From 250 — flyers don't make sense below that",
      days: 5,
    },
    card: {
      label: 'Card',
      sizes: [
        {k:'BC', v:'Business Card · 85×55 mm', mult:1.0},
        {k:'A7', v:'A7 · 74×105 mm', mult:1.3},
        {k:'A6', v:'A6 · 105×148 mm', mult:1.8},
        {k:'A5', v:'A5 · 148×210 mm', mult:2.5},
        {k:'A4', v:'A4 · 210×297 mm', mult:3.5},
      ],
      papers: [
        {k:'ms400', v:'MultiArt Silk · 400 gsm', mult:1.5},
        {k:'ms350', v:'MultiArt Silk · 350 gsm', mult:1.35},
        {k:'ms300', v:'MultiArt Silk · 300 gsm', mult:1.2},
        {k:'ms250', v:'MultiArt Silk · 250 gsm', mult:1.1},
        {k:'bt300', v:'Biotop · 300 gsm', mult:1.25},
        {k:'bt250', v:'Biotop · 250 gsm', mult:1.15},
        {k:'rs300', v:'Recystar · 300 gsm', mult:1.22},
        {k:'rs250', v:'Recystar · 250 gsm', mult:1.12},
      ],
      qtys: [20, 50, 100, 250, 500, 1000],
      hint: "From 20 — small luxury runs welcome",
      base: 0.10, days: 5,
    },
    poster: {
      label: 'Poster',
      sizes: [
        {k:'A3', v:'A3 · 297×420 mm', mult:1.0},
        {k:'A4', v:'A4 · 210×297 mm', mult:0.62},
        // Banner-fed, one strip per mother sheet. `papers` restricts the stock
        // list: only MultiArt is cut for this format for now.
        {k:'LP', v:'Tall poster · 300×600 mm', mult:2.2,
         papers:['ms115','ms130','ms170']},
      ],
      papers: [
        {k:'ms115', v:'MultiArt Silk · 115 gsm'},
        {k:'ms130', v:'MultiArt Silk · 130 gsm'},
        {k:'ms170', v:'MultiArt Silk · 170 gsm'},
        {k:'bt120', v:'Biotop · 120 gsm'},
        {k:'bt160', v:'Biotop · 160 gsm'},
        {k:'rs135', v:'Recystar · 135 gsm'},
      ],
      // Index 2 = ms170. New stocks are appended so this stays put.
      defaultPaperIdx: 2,
      qtys: [10, 25, 50, 100],
      hint: "A3 here — A2 and larger → request quote",
      days: 5,
    },
  };

  // ── Cart-based state ─────────────────────────────────────────────────────
  // The customer configures one product at a time in the "draft"; clicking
  // "Add to order" snapshots it into the cart so a second product can be added.
  // Order-level fields (delivery, express, customer info) apply to the entire cart.
  const MAX_ITEMS = 10;

  function newDraft(product = 'flyer') {
    const p = PRODUCTS[product];
    return {
      id: '',
      product,
      sizeIdx: 0,
      paperIdx: p.defaultPaperIdx ?? 0,
      qty: p.qtys[0],
      versions: 1,
      sides: 1,
      uploadId: '',
      uploadFiles: [],
      uploadInFlight: 0,
      uploadProgress: 0,
      uploadError: '',
      price: null,
    };
  }

  const state = {
    cart: [],
    draft: newDraft('flyer'),
    editingId: null,
    express: false, delivery: 'pickup',
    custName: '', custEmail: '', custPhone: '',
    isCompany: false, custCompany: '', vatNumber: '',
    custAddress: '', custZip: '', custCity: '', country: 'BE',
    diffShip: false, shipAddress: '', shipZip: '', shipCity: '',
  };

  const PAY_URL    = `https://clickclick.be${CALC_DIR}/pay.php`;
  const UPLOAD_URL = (location.hostname === 'localhost' || location.hostname.startsWith('127.'))
    ? 'https://clickclick.be/calculator/upload.php'
    : `${CALC_DIR}/upload.php`;
  const MAX_UPLOAD_BYTES = 100 * 1024 * 1024;
  const UPLOAD_EXT_OK = ['pdf','jpg','jpeg','png','tiff','tif'];

  const $ = sel => document.querySelector(sel);
  const qtyGroup = $('#qtyGroup'), sizeSelect = $('#sizeSelect'), paperSelect = $('#paperSelect');
  // Set by applyUrlPrefill when a deep-linked paper_key isn't offered for the
  // deep-linked product. Cleared as soon as the customer changes the paper.
  let prefillPaperMissing = null;

  const fmtEUR = n => n.toLocaleString('fr-BE',{minimumFractionDigits:2,maximumFractionDigits:2}).replace(',', '.');

  // ─── Render the configurator (top of page) from state.draft ──────────────
  function renderConfigurator(){
    const d = state.draft;
    const p = PRODUCTS[d.product];
    document.querySelectorAll('.products .tile').forEach(t => t.classList.toggle('on', t.dataset.p === d.product));
    qtyGroup.innerHTML = p.qtys.map(q =>
      `<button class="qty${q===d.qty?' on':''}" data-q="${q}">${q}</button>`).join('');
    sizeSelect.innerHTML = p.sizes.map((s,i) =>
      `<option value="${i}"${i===d.sizeIdx?' selected':''}>${s.v}</option>`).join('');
    // A size may restrict which papers it can be printed on. Options stay in
    // place (paperIdx indexes p.papers, so removing them would shift every
    // index) — they are disabled instead, and an illegal selection snaps to
    // the first legal one.
    const allowedPapers = p.sizes[d.sizeIdx] && p.sizes[d.sizeIdx].papers;
    if (allowedPapers && !allowedPapers.includes(p.papers[d.paperIdx].k)) {
      const firstOk = p.papers.findIndex(pp => allowedPapers.includes(pp.k));
      if (firstOk !== -1) d.paperIdx = firstOk;
    }
    paperSelect.innerHTML = p.papers.map((pp,i) => {
      const blocked = allowedPapers && !allowedPapers.includes(pp.k);
      return `<option value="${i}"${i===d.paperIdx?' selected':''}` +
             `${blocked?' disabled':''}>${pp.v}</option>`;
    }).join('');
    const paperWarn = document.getElementById('paperWarn');
    if (paperWarn) paperWarn.hidden = !prefillPaperMissing;
    document.querySelectorAll('#sidesGroup button').forEach(b => b.classList.toggle('on', parseInt(b.dataset.sides, 10) === d.sides));
    document.getElementById('versionsInput').value = String(d.versions);
    if (typeof syncCustomQty === 'function') syncCustomQty();
    renderVersionsTotal();
    renderUploadHint();
    renderUpload();
    // editing pill + add-button label
    const pill = document.getElementById('editingPill');
    const addLbl = document.getElementById('btnAddLbl');
    if (state.editingId) {
      pill.hidden = false;
      addLbl.textContent = t('cart.update');
    } else {
      pill.hidden = true;
      addLbl.textContent = t('cart.add');
    }
  }

  // ─── Pricing (server-side; one batched call for cart + draft) ────────────
  let inflight = null;
  let pendingTimer = null;
  let lastTotals = null;     // {subtotalInclVat, deliveryInclVat, totalInclVat, ...}
  let csrfToken = '';        // fetched on load from /calculator/csrf.php?issue=1

  // ─── CSRF — fetch a one-shot token used by pay.php ──────────────────────
  // The token is consumed on the first successful pay.php submit. If that
  // submit fails (validation error, network blip), pay.php returns 403 +
  // "Session expired"; we then re-fetch a fresh token on the next try.
  const CSRF_URL = (location.hostname === 'localhost' || location.hostname.startsWith('127.'))
    ? 'https://clickclick.be/calculator/csrf.php'
    : `${CALC_DIR}/csrf.php`;

  async function fetchCsrfToken() {
    try {
      const res = await fetch(`${CSRF_URL}?issue=1`, { credentials: 'omit' });
      if (!res.ok) return;
      const json = await res.json();
      if (json && json.ok && typeof json.token === 'string') {
        csrfToken = json.token;
      }
    } catch (_) {
      // Silent — pay.php will surface "Session expired" if we couldn't get a token.
    }
  }

  // Build the items[] payload — draft is included only if it's "complete" enough
  // to price (which it always is, since the user can't set invalid values via the UI).
  function itemPayload(it) {
    const p = PRODUCTS[it.product];
    return {
      id:        it.id || null,
      product:   it.product,
      paper_key: p.papers[it.paperIdx].k,
      size:      p.sizes[it.sizeIdx].k,
      qty:       it.qty,
      versions:  it.versions,
      sides:     it.sides === 2 ? 'double' : 'single',
    };
  }

  function buildCalcPayload() {
    const items = [...state.cart.map(itemPayload), itemPayload(state.draft)];
    // Annotate items so we can splat the response back onto cart/draft below.
    return {
      items,
      express:  state.express,
      delivery: state.delivery,
    };
  }

  async function fetchPrice() {
    if (inflight) inflight.abort?.();
    const ctrl = new AbortController();
    inflight = ctrl;
    try {
      const body = buildCalcPayload();
      const res = await fetch(CALC_URL, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(body),
        signal:  ctrl.signal,
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const json = await res.json();
      if (!json.ok) throw new Error(json.error || 'calc failed');
      if (ctrl !== inflight) return;
      // Response item order matches request item order: [...cart, draft].
      const respItems = json.items || [];
      for (let i = 0; i < state.cart.length; i++) {
        state.cart[i].price = priceFromResp(respItems[i]);
      }
      state.draft.price = priceFromResp(respItems[state.cart.length]);
      // Compute order totals from CART items only (the draft is just a preview).
      const cartSubInc = state.cart.reduce((s, it) => s + (it.price?.inclVat ?? 0), 0);
      const cartSubEx  = state.cart.reduce((s, it) => s + (it.price?.exVat   ?? 0), 0);
      const delInc = json.deliveryInclVat ?? 0;
      const delEx  = json.deliveryExVat   ?? 0;
      lastTotals = {
        subtotalInclVat: Math.round(cartSubInc * 100) / 100,
        subtotalExVat:   Math.round(cartSubEx  * 100) / 100,
        deliveryInclVat: delInc,
        deliveryExVat:   delEx,
        totalInclVat:    Math.round((cartSubInc + delInc) * 100) / 100,
        totalExVat:      Math.round((cartSubEx  + delEx)  * 100) / 100,
        // Server-computed deadline — see the ready-by block in renderCart().
        productionDeadline: json.productionDeadline ?? null,
        productionDays:     json.productionDays     ?? null,
      };
      renderCart();
      updateOrderButton();
      updateAddButton();
    } catch (err) {
      if (err.name === 'AbortError') return;
      console.error('calc.php error:', err);
      state.draft.price = null;
      for (const item of state.cart) item.price = null;
      lastTotals = null;
      renderCart();
      updateOrderButton();
      updateAddButton();
    } finally {
      if (ctrl === inflight) inflight = null;
    }
  }

  function priceFromResp(r) {
    if (!r) return null;
    return {
      inclVat:      r.inclVat,
      exVat:        r.exVat,
      perPieceIncl: r.perPieceIncl,
      perPieceEx:   r.perPieceEx,
    };
  }

  function schedulePriceFetch() {
    clearTimeout(pendingTimer);
    pendingTimer = setTimeout(fetchPrice, 180);
  }

  function invalidatePrice() {
    state.draft.price = null;
    for (const item of state.cart) item.price = null;
    lastTotals = null;
    renderCart();
    schedulePriceFetch();
  }

  // ─── Render the cart panel (right sidebar) ───────────────────────────────
  function fmtMoney(n) {
    if (typeof n !== 'number' || !isFinite(n)) return '—';
    return '€' + n.toFixed(2).replace('.', ',');
  }

  function itemTitle(it) {
    const p = PRODUCTS[it.product];
    return `${t('product.' + it.product)} · ${p.sizes[it.sizeIdx].k} · ${it.qty}`;
  }
  function itemMeta(it) {
    const p = PRODUCTS[it.product];
    const sides = it.sides === 2 ? t('sides.rectoVerso') : t('sides.recto');
    const versionsBit = it.versions > 1 ? ` · ${it.versions} ${t('versions.unit')}` : '';
    return `${p.papers[it.paperIdx].v} · ${sides}${versionsBit}`;
  }

  function renderCart() {
    const list  = document.getElementById('cartItems');
    const empty = document.getElementById('cartEmpty');
    const totals = document.getElementById('cartTotals');
    const ready = document.getElementById('readyBlock');

    if (state.cart.length === 0) {
      list.innerHTML = '';
      empty.hidden = false;
      totals.hidden = true;
      ready.hidden = true;
      return;
    }

    empty.hidden = true;
    list.innerHTML = state.cart.map(it => {
      const isEditing = it.id === state.editingId;
      const priceLabel = it.price
        ? fmtMoney(it.price.inclVat)
        : `<span class="pending">${escapeHtml(t('cart.pricing'))}</span>`;
      const filesCount = it.uploadFiles.length;
      const filesBadge = filesCount > 0
        ? `<span class="ci-files">${escapeHtml(t('cart.files', { n: filesCount }))}</span>`
        : `<span class="ci-files missing">${escapeHtml(t('cart.uploadRequired'))}</span>`;
      return `<li class="cart-item${isEditing ? ' editing' : ''}" data-id="${escapeHtml(it.id)}">
        <div class="ci-top">
          <div class="ci-title">${escapeHtml(itemTitle(it))}</div>
          <div class="ci-price${it.price ? '' : ' pending'}">${priceLabel}</div>
        </div>
        <div class="ci-meta">${escapeHtml(itemMeta(it))}</div>
        ${filesBadge}
        <div class="ci-actions">
          <button type="button" class="ci-btn edit" data-act="edit" data-id="${escapeHtml(it.id)}">${escapeHtml(t('cart.edit'))}</button>
          <button type="button" class="ci-btn remove" data-act="remove" data-id="${escapeHtml(it.id)}">${escapeHtml(t('cart.remove'))}</button>
        </div>
      </li>`;
    }).join('');

    // Totals
    if (lastTotals) {
      document.getElementById('totSubtotal').textContent = fmtMoney(lastTotals.subtotalInclVat);
      document.getElementById('totDelivery').textContent = fmtMoney(lastTotals.deliveryInclVat);
      document.getElementById('totDeliveryLbl').textContent = t(state.delivery === 'dpd' ? 'cart.deliveryShip' : 'cart.deliveryPickup');
      document.getElementById('totTotal').textContent    = fmtMoney(lastTotals.totalInclVat);
      document.getElementById('totEx').textContent       = fmtMoney(lastTotals.totalExVat);
      totals.hidden = false;
    } else {
      totals.hidden = true;
    }

    // Ready-by date. Prefer the server's deadline (Europe/Brussels, Belgian
    // public holidays excluded) so the customer sees exactly the date pay.php
    // will record on the order. The local estimate below is only a fallback for
    // when no price call has landed yet — it knows nothing about holidays.
    const slowest = Math.max(...state.cart.map(it => PRODUCTS[it.product].days));
    let days = state.express ? 2 : slowest;
    let d;
    if (lastTotals && lastTotals.productionDeadline) {
      d = new Date(lastTotals.productionDeadline + 'T12:00:00');
      days = lastTotals.productionDays || days;
    } else {
      d = new Date();
      let added = 0;
      while (added < days) { d.setDate(d.getDate() + 1); if (d.getDay() !== 0 && d.getDay() !== 6) added++; }
    }
    const localeMap = { en: 'en-GB', fr: 'fr-BE', nl: 'nl-BE' };
    document.getElementById('readyDate').textContent = d.toLocaleDateString(localeMap[getLang()] || 'en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
    document.getElementById('readyDays').textContent = state.express ? t('ready.express') : t('ready.days', { n: days });
    document.getElementById('readyPrefix').textContent = t(state.delivery === 'pickup' ? 'ready.pickup' : 'ready.ship');
    ready.hidden = false;
  }

  // ─── Tile click: change product type of the *draft* (not order-wide) ─────
  document.querySelector('.products').addEventListener('click', e => {
    const btn = e.target.closest('.tile'); if (!btn) return;
    const newProduct = btn.dataset.p;
    if (newProduct === state.draft.product) return;
    // Preserve the draft's uploadId/files (customer already uploaded for this draft),
    // but reset size/paper/qty to defaults for the new product.
    const carryUpload = { uploadId: state.draft.uploadId, uploadFiles: state.draft.uploadFiles };
    const fresh = newDraft(newProduct);
    fresh.id       = state.draft.id;          // keep editingId target if mid-edit
    fresh.uploadId = carryUpload.uploadId;
    fresh.uploadFiles = carryUpload.uploadFiles;
    state.draft = fresh;
    invalidatePrice();
    renderConfigurator();
  });

  qtyGroup.addEventListener('click', e => {
    const btn = e.target.closest('.qty'); if (!btn) return;
    state.draft.qty = parseInt(btn.dataset.q, 10);
    syncCustomQty();
    invalidatePrice();
    renderConfigurator();
  });

  // ─── Custom quantity input (free-form 1..10000) ─────────────────────────
  // Lets customers type any qty when the preset chips don't fit their need.
  // Stays in lock-step with state.draft.qty: typing here updates the draft + clears
  // the preset chip highlights; clicking a preset chip mirrors back here.
  const customQty = document.getElementById('customQty');

  function syncCustomQty() {
    if (!customQty) return;
    const presets = PRODUCTS[state.draft.product].qtys;
    const isPreset = presets.includes(state.draft.qty);
    customQty.value = isPreset ? '' : String(state.draft.qty);
    customQty.classList.toggle('on', !isPreset);
  }

  let customQtyTimer = null;
  if (customQty) {
    customQty.addEventListener('input', () => {
      let v = parseInt(customQty.value, 10);
      if (!Number.isFinite(v)) return;
      v = Math.max(1, Math.min(10000, v));
      state.draft.qty = v;
      const presets = PRODUCTS[state.draft.product].qtys;
      qtyGroup.querySelectorAll('.qty').forEach(b => {
        b.classList.toggle('on', parseInt(b.dataset.q, 10) === v);
      });
      customQty.classList.toggle('on', !presets.includes(v));
      renderVersionsTotal();
      clearTimeout(customQtyTimer);
      customQtyTimer = setTimeout(() => { invalidatePrice(); }, 350);
    });
    customQty.addEventListener('blur', () => {
      let v = parseInt(customQty.value, 10);
      if (!Number.isFinite(v) || v < 1) v = state.draft.qty;
      v = Math.max(1, Math.min(10000, v));
      state.draft.qty = v;
      syncCustomQty();
      invalidatePrice();
      renderConfigurator();
    });
  }

  // ─── Versions / sides / size / paper change the DRAFT ────────────────────
  function maxUploadFiles() {
    return Math.max(1, state.draft.versions * (state.draft.sides === 2 ? 2 : 1));
  }

  function renderVersionsTotal() {
    const el = document.getElementById('versionsTotal');
    if (!el) return;
    if (state.draft.versions <= 1) {
      el.hidden = true; el.innerHTML = '';
      return;
    }
    el.hidden = false;
    const total = state.draft.qty * state.draft.versions;
    el.innerHTML = `${state.draft.qty} × ${state.draft.versions} ${t('versions.unit')} = <strong>${total} ${t('versions.copies')}</strong>`;
  }

  function renderUploadHint() {
    const hint = document.querySelector('#uploadZone .upload-hint');
    if (!hint) return;
    const max = maxUploadFiles();
    hint.textContent = max > 1
      ? `${t('upload.types')} · ${t('upload.maxFiles', { n: max })}`
      : t('upload.types');
  }

  function setVersions(n) {
    n = Math.max(1, Math.min(10, parseInt(n, 10) || 1));
    state.draft.versions = n;
    const inp = document.getElementById('versionsInput');
    if (inp && inp.value !== String(n)) inp.value = String(n);
    renderVersionsTotal();
    renderUploadHint();
    invalidatePrice();
  }

  document.getElementById('versionsInput').addEventListener('input',  e => setVersions(e.target.value));
  document.getElementById('versionsInput').addEventListener('change', e => setVersions(e.target.value));
  document.getElementById('versionsDec').addEventListener('click',    () => setVersions(state.draft.versions - 1));
  document.getElementById('versionsInc').addEventListener('click',    () => setVersions(state.draft.versions + 1));
  sizeSelect.addEventListener('change',  e => { state.draft.sizeIdx  = parseInt(e.target.value, 10); renderConfigurator(); invalidatePrice(); });
  paperSelect.addEventListener('change', e => { state.draft.paperIdx = parseInt(e.target.value, 10); prefillPaperMissing = null; invalidatePrice(); });
  document.getElementById('sidesGroup').addEventListener('click', e => {
