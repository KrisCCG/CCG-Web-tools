  let quoteSending = false;
  document.getElementById('btnQuote').addEventListener('click', async () => {
    if (quoteSending) return;
    const msg = document.getElementById('quoteMsg');
    const btn = document.getElementById('btnQuote');
    const show = (key) => { msg.hidden = false; msg.textContent = t(key); };

    if (state.cart.length === 0 || !customerFieldsValid()) { show('intl.needDetails'); return; }

    quoteSending = true;
    btn.classList.add('disabled');
    try {
      const base = buildSubmitPayload();
      const res = await fetch(`https://clickclick.be${CALC_DIR}/quote.php`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({
          items:            base.items,
          express:          state.express,
          country:          state.country,
          customer_name:    base.customer_name,
          customer_email:   base.customer_email,
          customer_phone:   base.customer_phone,
          customer_company: base.customer_company,
          customer_address: base.customer_address,
          customer_zip:     base.customer_zip,
          customer_city:    base.customer_city,
          ship_address:     state.diffShip ? state.shipAddress : '',
          ship_zip:         state.diffShip ? state.shipZip     : '',
          ship_city:        state.diffShip ? state.shipCity    : '',
          vat_number:       base.vat_number,
          lang:             getLang(),
          csrf_token:       csrfToken,
        }),
      });
      const json = await res.json().catch(() => null);
      if (!res.ok || !json || !json.ok) {
        if (res.status === 403) { csrfToken = ''; fetchCsrfToken(); }
