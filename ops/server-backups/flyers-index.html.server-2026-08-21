  // Outside Belgium the shop can't price shipping, so the order becomes a
  // hand-quoted request instead of a payment.
  function updateQuoteBox() {
    const box = document.getElementById('quoteBox');
    const btn = document.querySelector('.btn-order');
    const abroad = state.country !== 'BE';
    box.hidden = !abroad;
    if (btn) btn.hidden = abroad;
