  // ─── Validation: cart-level vs. add-to-cart-level ────────────────────────
  function customerFieldsValid() {
    if (!state.custName || !state.custEmail || !state.custAddress || !state.custCity) return false;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.custEmail)) return false;
    if (state.delivery === 'dpd' && state.diffShip) {
      if (!state.shipAddress || !state.shipCity) return false;
    }
    return true;
  }

  function draftHasFiles() {
    return state.draft.uploadFiles.length > 0 && state.draft.uploadInFlight === 0 && !!state.draft.uploadId;
  }

  function canAddToOrder() {
    if (!draftHasFiles()) return false;
    if (!state.draft.price) return false;
    if (state.editingId == null && state.cart.length >= MAX_ITEMS) return false;
    return true;
  }

  function canCheckout() {
    if (state.cart.length === 0) return false;
    if (!customerFieldsValid()) return false;
    if (!lastTotals) return false;
    // Every cart item needs files + a server-confirmed price
    return state.cart.every(it => it.uploadFiles.length > 0 && it.uploadInFlight === 0 && !!it.price);
  }

  function updateAddButton() {
    const btn   = document.getElementById('btnAdd');
    const lbl   = document.getElementById('btnAddLbl');
    const amt   = document.getElementById('btnAddAmt');
    const hint  = document.getElementById('addHint');
    if (!btn) return;
    btn.disabled = !canAddToOrder();
    lbl.textContent = state.editingId ? t('cart.update') : t('cart.add');
    amt.textContent = state.draft.price ? fmtMoney(state.draft.price.inclVat) : '';
    if (hint) {
      if (!draftHasFiles()) {
        hint.textContent = t('cart.addHintUpload');
      } else if (state.cart.length >= MAX_ITEMS && state.editingId == null) {
        hint.textContent = t('cart.addHintMax', { max: MAX_ITEMS });
      } else {
        hint.textContent = t('cart.addHint');
      }
    }
  }

  function updateOrderButton() {
    const btn = document.querySelector('.btn-order');
    if (!btn) return;
    const label = btn.querySelector('span:first-child');
    if (canCheckout()) {
      btn.classList.remove('disabled');
      label.textContent = t('btn.pay', { amount: lastTotals.totalInclVat.toFixed(2).replace('.', ',') });
    } else {
      btn.classList.add('disabled');
      if (state.cart.length === 0) {
        label.textContent = t('cart.fillRequired');
      } else if (!customerFieldsValid()) {
        label.textContent = t('btn.fillRequired');
      } else if (!lastTotals) {
        label.textContent = t('cart.pricing');
      } else {
        label.textContent = t('cart.fillRequired');
      }
    }
  }

  function updateReceiptNote() {
    const note = document.getElementById('receiptNote');
    if (!note) return;
    note.textContent = t(state.isCompany ? 'rules.receiptCo' : 'rules.receipt');
  }

  // ─── Add / update / remove cart items ────────────────────────────────────
  function addOrUpdateCart() {
    if (!canAddToOrder()) return;
    const snapshot = {
      id:           state.editingId || genItemId(),
      product:      state.draft.product,
      sizeIdx:      state.draft.sizeIdx,
      paperIdx:     state.draft.paperIdx,
      qty:          state.draft.qty,
      versions:     state.draft.versions,
      sides:        state.draft.sides,
      uploadId:     state.draft.uploadId,
      uploadFiles:  state.draft.uploadFiles.slice(),
      uploadInFlight: 0, uploadProgress: 0, uploadError: '',
      price:        state.draft.price,
    };
    if (state.editingId) {
      const idx = state.cart.findIndex(it => it.id === state.editingId);
      if (idx >= 0) state.cart[idx] = snapshot; else state.cart.push(snapshot);
      state.editingId = null;
    } else {
      state.cart.push(snapshot);
    }
    // Reset draft so a fresh configuration can begin
    state.draft = newDraft(state.draft.product);
    // Reset sides toggle UI
    document.querySelectorAll('#sidesGroup button').forEach((b, i) => b.classList.toggle('on', i === 0));
    invalidatePrice();
    renderConfigurator();
    renderCart();
    updateOrderButton();
    updateAddButton();
  }

  function editCartItem(id) {
    const it = state.cart.find(x => x.id === id);
    if (!it) return;
    state.draft = {
      id:           it.id,
      product:      it.product,
      sizeIdx:      it.sizeIdx,
      paperIdx:     it.paperIdx,
      qty:          it.qty,
      versions:     it.versions,
      sides:        it.sides,
      uploadId:     it.uploadId,
      uploadFiles:  it.uploadFiles.slice(),
      uploadInFlight: 0, uploadProgress: 0, uploadError: '',
      price:        it.price,
    };
    state.editingId = it.id;
    renderConfigurator();
    renderCart();
    updateAddButton();
    document.querySelector('.flow').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function removeCartItem(id) {
    const idx = state.cart.findIndex(x => x.id === id);
    if (idx < 0) return;
    const it = state.cart[idx];
    // Best-effort: DELETE each file from the temp folder
    for (const f of it.uploadFiles) {
      fetch(
        `${UPLOAD_URL}?upload_id=${encodeURIComponent(it.uploadId)}&filename=${encodeURIComponent(f.filename)}`,
        { method: 'DELETE' }
      ).catch(() => {});
    }
    state.cart.splice(idx, 1);
    if (state.editingId === id) {
      state.editingId = null;
      state.draft = newDraft(state.draft.product);
      renderConfigurator();
    }
    invalidatePrice();
    renderCart();
    updateOrderButton();
    updateAddButton();
  }

  function genItemId() {
    if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
      return crypto.randomUUID();
    }
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
    });
  }

  // ─── Cart panel: click handlers (edit / remove) ──────────────────────────
  document.getElementById('cartItems').addEventListener('click', e => {
    const btn = e.target.closest('.ci-btn');
    if (!btn) return;
    const act = btn.dataset.act;
    const id  = btn.dataset.id;
    if (act === 'edit')   editCartItem(id);
    if (act === 'remove') removeCartItem(id);
  });

  // ─── Add to order CTA ────────────────────────────────────────────────────
  document.getElementById('btnAdd').addEventListener('click', e => {
    e.preventDefault();
    addOrUpdateCart();
  });

  // ─── Checkout (Pay) CTA ──────────────────────────────────────────────────
  function buildSubmitPayload() {
    const items = state.cart.map(it => {
      const p = PRODUCTS[it.product];
      return {
        id:        it.id,
        product:   it.product,
        paper_key: p.papers[it.paperIdx].k,
        size:      p.sizes[it.sizeIdx].k,
        qty:       it.qty,
        versions:  it.versions,
        sides:     it.sides === 2 ? 'double' : 'single',
        upload_id: it.uploadId,
      };
    });
    const payload = {
      items,
      express:           state.express,
      delivery:          state.delivery,
      payment_type:      'bancontact',
      customer_name:     state.custName,
      customer_email:    state.custEmail,
      customer_phone:    state.custPhone,
      customer_company:  state.isCompany ? state.custCompany : '',
      customer_address:  state.custAddress,
      customer_zip:      state.custZip,
      customer_city:     state.custCity,
      doc_type:          state.isCompany ? 'invoice' : 'receipt',
      receipt_email:     'shop@clickclickgraphics.com',
      vat_number:        state.isCompany ? state.vatNumber : '',
      claimed_total_cents: lastTotals ? Math.round(lastTotals.totalInclVat * 100) : 0,
      csrf_token:        csrfToken,
    };
    if (state.delivery === 'dpd' && state.diffShip) {
      payload.ship_address = state.shipAddress;
      payload.ship_zip     = state.shipZip;
      payload.ship_city    = state.shipCity;
    }
    return payload;
  }

  let submitting = false;
  async function submitOrder() {
    if (!canCheckout() || submitting) return;
    submitting = true;
    const btn = document.querySelector('.btn-order');
    btn && btn.classList.add('disabled');
    try {
      const res = await fetch(PAY_URL, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(buildSubmitPayload()),
      });
      const json = await res.json().catch(() => null);
      if (!res.ok || !json || !json.ok || !json.checkoutUrl) {
        // CSRF tokens are one-shot — refresh on 403 so the next try works.
        if (res.status === 403) {
          csrfToken = '';
          fetchCsrfToken();
        }
        const msg = (json && json.error) ? `${t('cart.payError')} (${json.error})` : t('cart.payError');
        alert(msg);
        submitting = false;
        updateOrderButton();
        return;
      }
      window.top.location.href = json.checkoutUrl;
    } catch (err) {
      console.error('pay.php error:', err);
      alert(t('cart.payError'));
      submitting = false;
      updateOrderButton();
    }
  }

  document.querySelector('.btn-order').addEventListener('click', e => {
    e.preventDefault();
    submitOrder();
  });

  // ─── Artwork upload (multi-file) — operates on state.draft ──────────────
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  }

  function fmtBytes(n) {
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' KB';
    return (n / 1024 / 1024).toFixed(1) + ' MB';
  }

  function renderUpload() {
    const zone   = document.getElementById('uploadZone');
    const status = document.getElementById('uploadStatus');
    if (!zone || !status) return;

    zone.classList.remove('uploading','error','dragover');
    if (state.draft.uploadInFlight > 0) zone.classList.add('uploading');

    const out = [];
    if (state.draft.uploadFiles.length > 0) {
      out.push('<ul class="upload-list">');
      for (let i = 0; i < state.draft.uploadFiles.length; i++) {
        const f = state.draft.uploadFiles[i];
        out.push(
          `<li class="upload-item">` +
            `<span class="file">✓ ${escapeHtml(f.filename)}</span>` +
            `<span class="size">${fmtBytes(f.size)}</span>` +
            `<button type="button" class="upload-remove" data-i="${i}" aria-label="Remove ${escapeHtml(f.filename)}">${escapeHtml(t('upload.remove'))}</button>` +
          `</li>`
        );
      }
      out.push('</ul>');
    }
    if (state.draft.uploadInFlight > 0) {
      out.push(`<div class="upload-progress">${escapeHtml(t('upload.uploading'))} ${state.draft.uploadProgress}%<div class="upload-bar"><span style="width:${state.draft.uploadProgress}%"></span></div></div>`);
    }
    if (state.draft.uploadError) {
      out.push(`<div class="upload-error">${escapeHtml(state.draft.uploadError)}</div>`);
    }
    status.innerHTML = out.join('');
  }

  // Generate a UUID-v4 client-side so concurrent uploads share the same
  // server-side temp folder. Falls back to Math.random() on very old browsers.
  function genUploadId() {
    if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
      return crypto.randomUUID();
    }
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
    });
  }

  function uploadFile(file) {
    const ext = (file.name.split('.').pop() || '').toLowerCase();
    if (!UPLOAD_EXT_OK.includes(ext)) {
      state.draft.uploadError = t('upload.error.invalidType');
      renderUpload(); return;
    }
    if (file.size > MAX_UPLOAD_BYTES) {
      state.draft.uploadError = t('upload.error.tooLarge');
      renderUpload(); return;
    }
    const cap = maxUploadFiles();
    if (state.draft.uploadFiles.length + state.draft.uploadInFlight >= cap) {
      state.draft.uploadError = t('upload.error.tooMany', { max: cap });
      renderUpload(); return;
    }

    if (!state.draft.uploadId) state.draft.uploadId = genUploadId();

    state.draft.uploadError = '';
    state.draft.uploadInFlight++;
    state.draft.uploadProgress = 0;
    renderUpload(); updateAddButton(); updateOrderButton();

    const fd = new FormData();
    fd.append('file', file);
    fd.append('upload_id', state.draft.uploadId);

    const xhr = new XMLHttpRequest();
    xhr.upload.onprogress = e => {
      if (e.lengthComputable) {
        state.draft.uploadProgress = Math.round((e.loaded / e.total) * 100);
        renderUpload();
      }
    };
    xhr.onload = () => {
      state.draft.uploadInFlight--;
      let resp = null;
      try { resp = JSON.parse(xhr.responseText); } catch (_) {}
      if (xhr.status === 200 && resp && resp.ok) {
        state.draft.uploadId = resp.upload_id;
        state.draft.uploadFiles.push({ filename: resp.filename, size: resp.size });
      } else {
        const errKey = resp && resp.error === 'file too large' ? 'upload.error.tooLarge'
                     : resp && resp.error === 'invalid type'   ? 'upload.error.invalidType'
                     :                                            'upload.error.failed';
        state.draft.uploadError = t(errKey);
      }
      renderUpload(); updateAddButton(); updateOrderButton();
    };
    xhr.onerror = () => {
      state.draft.uploadInFlight--;
      state.draft.uploadError = t('upload.error.failed');
      renderUpload(); updateAddButton(); updateOrderButton();
    };
    xhr.open('POST', UPLOAD_URL);
    xhr.send(fd);
  }

  function uploadFiles(fileList) {
    Array.from(fileList || []).forEach(uploadFile);
  }

  function removeFile(idx) {
    const f = state.draft.uploadFiles[idx];
    if (!f || !state.draft.uploadId) return;
    const id = state.draft.uploadId;

    state.draft.uploadFiles.splice(idx, 1);
    state.draft.uploadError = '';
    if (state.draft.uploadFiles.length === 0) state.draft.uploadId = '';
    renderUpload(); updateAddButton(); updateOrderButton();

    fetch(
      `${UPLOAD_URL}?upload_id=${encodeURIComponent(id)}&filename=${encodeURIComponent(f.filename)}`,
      { method: 'DELETE' }
    ).catch(() => {});
  }

  (function wireUpload() {
    const zone  = document.getElementById('uploadZone');
    const input = document.getElementById('fileInput');
    if (!zone || !input) return;

    input.addEventListener('change', () => {
      uploadFiles(input.files);
      input.value = '';
    });

    zone.addEventListener('click', e => {
      const btn = e.target.closest('.upload-remove');
      if (btn) { e.stopPropagation(); removeFile(parseInt(btn.dataset.i, 10)); return; }
      input.click();
    });
    zone.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
    });

    ['dragenter','dragover'].forEach(evt => {
      zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.add('dragover'); });
    });
    ['dragleave','dragend'].forEach(evt => {
      zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.remove('dragover'); });
    });
    zone.addEventListener('drop', e => {
      e.preventDefault();
      zone.classList.remove('dragover');
      uploadFiles(e.dataTransfer && e.dataTransfer.files);
    });
  })();

  // Keep ship block + button state in sync with delivery changes
  document.querySelectorAll('.deliver label').forEach(lbl => {
    lbl.addEventListener('click', () => {
      setTimeout(() => { updateShipBlockVisibility(); updateOrderButton(); }, 0);
    });
  });

  // ─────────────────────────────────────────────────────────────────────
  // URL prefill — accept ?product=&paper_key=&size=&qty=&sides=&express=
  //                      &delivery=&custName=… so other tools (e.g.
  // tiegel.be smartbot) can deep-link a fully configured FIRST item.
  // Specs land on state.draft; order envelope + customer fields on state.
  // Silently ignores anything that doesn't match the product catalog.
  // ─────────────────────────────────────────────────────────────────────
  (function applyUrlPrefill() {
    const q = new URLSearchParams(location.search);
    if (![...q.keys()].length) return;

    // product (on draft)
    const p = q.get('product');
    if (p && PRODUCTS[p]) {
      state.draft.product  = p;
      state.draft.sizeIdx  = 0;
      state.draft.paperIdx = PRODUCTS[p].defaultPaperIdx ?? 0;
      state.draft.qty      = PRODUCTS[p].qtys[0];
    }
    const prod = PRODUCTS[state.draft.product];

    // paper_key. If the requested paper isn't offered for this product we must
    // NOT quietly leave the default selected — that is how a "card on Biotop
    // 250" quote turned into MultiArt Silk 130 in the shop (found 17 Aug 2026).
    // Flag it instead, so the customer sees that their choice didn't carry over.
    const pk = q.get('paper_key');
    if (pk) {
      const idx = prod.papers.findIndex(x => x.k === pk);
      if (idx >= 0) {
        state.draft.paperIdx = idx;
      } else {
        prefillPaperMissing = pk;
        console.warn(`prefill: paper "${pk}" is not available for product "${state.draft.product}"`);
      }
    }
    // size
    const size = q.get('size');
    if (size) {
      const idx = prod.sizes.findIndex(x => x.k === size);
      if (idx >= 0) state.draft.sizeIdx = idx;
    }
    // qty — any 1..10000; renderConfigurator/syncCustomQty handle the UI
    const qty = parseInt(q.get('qty'), 10);
    if (Number.isFinite(qty) && qty >= 1 && qty <= 10000) {
      state.draft.qty = qty;
    }
    // sides — 1 = single, 2 = double
    const sides = q.get('sides');
    if (sides === 'double') state.draft.sides = 2;
    else if (sides === 'single') state.draft.sides = 1;

    // ── ORDER-LEVEL: express, delivery, customer fields ───────────────
    if (q.get('express') === '1') state.express = true;
    const delivery = q.get('delivery');
    if (delivery === 'pickup' || delivery === 'dpd') state.delivery = delivery;

    const contactMap = {
      custName:    'custName',
      custEmail:   'custEmail',
      custPhone:   'custPhone',
      custCompany: 'custCompany',
      vatNumber:   'vatNumber',
      custAddress: 'custAddress',
      custZip:     'custZip',
      custCity:    'custCity',
    };
    Object.entries(contactMap).forEach(([stateKey, inputId]) => {
      const v = q.get(inputId);
      if (v) {
        state[stateKey] = v;
        const el = document.getElementById(inputId);
        if (el) {
          el.value = v;
          el.dispatchEvent(new Event('input',  { bubbles: true }));
          el.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    });

    if (q.get('custCompany') || q.get('vatNumber')) {
      state.isCompany = true;
      const chk = document.getElementById('isCompany');
      if (chk) {
        chk.checked = true;
        chk.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    // Sync the static toggle buttons + express checkbox + deliver labels
    // to the prefilled state (tile/qty/size/paper/sides are handled by
    // renderConfigurator() below). For the express checkbox we BOTH set
    // .checked and dispatch a change event — the change handler is what
    // wires the visual state to applyExpressDeliveryLock() and the price
    // refresh, so a silent property assignment alone leaves the DPD label
    // unlocked and the receipt note stale.
    const expressChk = document.getElementById('expressChk');
    if (expressChk && state.express) {
      expressChk.checked = true;
      expressChk.dispatchEvent(new Event('change', { bubbles: true }));
    }
    document.querySelectorAll('.deliver label').forEach((lbl, i) => {
      const isPickup = i === 0;
      lbl.classList.toggle('on', (isPickup && state.delivery === 'pickup')
                              || (!isPickup && state.delivery === 'dpd'));
    });
  })();

  updateShipBlockVisibility();
  updateReceiptNote();
  applyExpressDeliveryLock();
  syncLegalLinks();
  renderConfigurator();
  renderCart();
  updateOrderButton();
  updateAddButton();

  // CSRF token + first price load fire in parallel — neither blocks the UI.
  fetchCsrfToken();
  fetchPrice();
</script>

</body>
</html>
