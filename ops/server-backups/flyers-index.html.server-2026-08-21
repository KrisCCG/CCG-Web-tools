  const LEGAL_PAGE = { en: '/legal/', fr: '/legal/fr.html', nl: '/legal/nl.html' };
  const PAPER_PAGE = { en: '/papers/', fr: '/papers/fr.html', nl: '/papers/nl.html' };
  function syncLegalLinks() {
