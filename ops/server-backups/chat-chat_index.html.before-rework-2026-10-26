<body>

<div id="ccs-header"></div>
<script src="lib/site-chrome/site-chrome.js?v=20261026"></script>

<div class="shell">

  <section class="hero">
    <h1 id="intro-heading"></h1>
    <p id="intro-body"></p>
  </section>

  <div class="chat-card">
    <div class="messages" id="messages" aria-live="polite"></div>
    <div class="skip-row" id="skip-row">
      <span class="hint" id="skip-hint"></span>
      <button type="button" class="btn-skip" id="skip-btn"></button>
    </div>
    <form class="composer" id="composer" autocomplete="off">
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <textarea id="input" rows="1" required maxlength="4000"></textarea>
      <button type="submit" class="btn-send" id="send-btn"></button>
    </form>
  </div>

  <div id="submit-area"></div>

  <footer class="page-footer">
    <p class="email-alt">
      <span id="email-alt-text"></span>
      <a href="mailto:info@clickclickgraphics.com">info@clickclickgraphics.com</a>
    </p>
    <p class="file-alt" id="file-alt-text"></p>
    <p class="privacy-line" id="privacy-notice"></p>
  </footer>

</div>

<div id="ccs-footer"></div>

<script src="lib/i18n.js?v=20261026b"></script>
<script>
(function () {
  'use strict';

  const state = {
    lang: window.detectLanguage(),
    langPinned: false,      // true once the customer picks a language by hand
    pageLoadedAt: Date.now(),
    conversationToken: null,
    history: [],
    awaitingReply: false,
    submitting: false,
    submitted: false,
    lastDraft: null,
    lastShopQuote: null,    // populated when bot calls check_shop_pricing
  };

  const API = {
    start:  '/chat-api/start.php',
    chat:   '/chat-api/chat.php',
    submit: '/chat-api/submit.php',
  };

  const $ = (id) => document.getElementById(id);
  const messagesEl = $('messages');
  const submitArea = $('submit-area');
  const composer   = $('composer');
  const inputEl    = $('input');
  const sendBtn    = $('send-btn');
  const skipRow    = $('skip-row');
  const skipBtn    = $('skip-btn');
  const skipHint   = $('skip-hint');

  function t(key) { return (window.I18N[state.lang] || window.I18N.en)[key] || key; }

  // The CONVERSATION language can differ from the UI language. Once the bot
  // has spoken, we trust its detected_language (in the latest draft) over
  // the UI default. Used for in-chat messages like the edit prompt.
  function tChat(key) {
    const lang = (state.lastDraft && state.lastDraft.detected_language)
                 || state.lang;
    return (window.I18N[lang] || window.I18N.en)[key] || key;
  }

  function applyLang() {
    document.documentElement.lang = state.lang;
    document.title = t('page_title');
    $('intro-heading').textContent  = t('intro_heading');
    $('intro-body').textContent     = t('intro_body');
    $('email-alt-text').textContent = t('email_alt');
    // Files: point to a transfer platform; the brand name becomes a link.
    const fa = $('file-alt-text');
    if (fa) {
      const parts = t('file_alt').split('SwissTransfer');
      fa.textContent = parts[0];
      if (parts.length > 1) {
        const a = document.createElement('a');
        a.href = 'https://www.swisstransfer.com/';
        a.target = '_blank'; a.rel = 'noopener';
        a.textContent = 'SwissTransfer';
        fa.appendChild(a);
        fa.appendChild(document.createTextNode(parts.slice(1).join('SwissTransfer')));
      }
    }
    $('privacy-notice').textContent = t('privacy_notice');
    inputEl.placeholder             = t('placeholder');
    sendBtn.textContent             = t('send');
    skipBtn.textContent             = t('skip_button');
    skipHint.textContent            = t('skip_hint');
    // Top-bar nav: the same four links as the shop, pointing at the file for
    // whichever language is being read.
    const P = { en:(window.CC_SITE||'')+'/en/paper-guide/', fr:(window.CC_SITE||'')+'/fr/guide-des-papiers/', nl:(window.CC_SITE||'')+'/nl/papiergids/' };
    const L = { en:(window.CC_SITE||'')+'/en/legal/', fr:(window.CC_SITE||'')+'/fr/mentions-legales/', nl:(window.CC_SITE||'')+'/nl/juridisch/' };
    const navMap = {
      navServices: ['nav_services', null],
      navShop:     ['nav_shop',     '/shop/'],
      navPaper:    ['nav_paper',    P[state.lang] || P.en],
      navTerms:    ['nav_terms',    L[state.lang] || L.en],
    };
    for (const id of Object.keys(navMap)) {
      const el = document.getElementById(id);
      if (!el) continue;
      el.textContent = t(navMap[id][0]);
      if (navMap[id][1]) el.href = navMap[id][1];
    }
    document.querySelectorAll('.langs button').forEach(b => {
      b.classList.toggle('on', b.dataset.lang === state.lang);
    });
    if (state.lastDraft && !state.submitted) renderSubmitPanel(state.lastDraft);
  }
  applyLang();

  // Move the whole UI to the language the bot detected the customer writing in.
  // Skipped once the customer has picked a language by hand — an explicit
  // choice outranks detection, otherwise their click would keep being undone.
  function syncLangToConversation(lang) {
    if (!lang || state.langPinned) return;
    if (!window.I18N[lang] || lang === state.lang) return;
    state.lang = lang;
    applyLang();
  }

  document.querySelectorAll('.langs button').forEach(b => {
    b.addEventListener('click', () => {
      state.lang = b.dataset.lang;
      state.langPinned = true;
      applyLang();
    });
  });

  function addMessage(text, role) {
    if (!text || !text.trim()) return null;
    // The bot is told to write plain text, but Haiku sometimes adds **bold** —
    // shown literally as asterisks, so strip the markers (Kris, 17 Oct).
    if (role === 'bot') text = text.replace(/\*\*([^*]+)\*\*/g, '$1').replace(/__([^_]+)__/g, '$1');
    const el = document.createElement('div');
    el.className = 'msg ' + role;
    el.textContent = text;
    messagesEl.appendChild(el);
    el.scrollIntoView({ behavior: 'smooth', block: 'end' });
    return el;
  }

  function addError(text) {
    const el = document.createElement('div');
    el.className = 'msg error';
    el.textContent = text;
    messagesEl.appendChild(el);
    el.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  let thinkingEl = null;
  function showThinking() {
    if (thinkingEl) return;
    thinkingEl = document.createElement('div');
    thinkingEl.className = 'thinking';
    thinkingEl.innerHTML = '<span>' + t('thinking') + '</span><span class="dot"></span><span class="dot"></span><span class="dot"></span>';
    messagesEl.appendChild(thinkingEl);
    thinkingEl.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }
  function hideThinking() {
    if (thinkingEl) { thinkingEl.remove(); thinkingEl = null; }
  }

  function renderSubmitPanel(draft) {
    state.editing = false;
    submitArea.innerHTML = '';
    const wrap = document.createElement('div');
    wrap.className = 'submit-panel';

    const heading = document.createElement('h3');
    heading.textContent = t('summary_heading');
    wrap.appendChild(heading);

    const rows = [
      ['Product',  draft.product],
      ['Quantity', draft.quantity],
      ['Size',     draft.size],
      ['Sides',    draft.sides],
      ['Paper',    draft.paper_preference],
      ['Finish',   (draft.finishings || []).join(', ')],
      ['Binding',  draft.binding],
      ['Deadline', draft.deadline],
      ['File',     draft.files_ready ? (draft.file_link ? draft.file_link : 'Ready') : 'Not ready / unsure'],
      ['Competitor quote', draft.competitor_quote_info],
      ['Shop visit', draft.requested_visit_time],
      ['Name',     draft.contact && draft.contact.name],
      ['Email',    draft.contact && draft.contact.email],
      ['Phone',    draft.contact && draft.contact.phone],
      ['Address',  draft.contact && draft.contact.address],
      ['Company',  draft.contact && draft.contact.company],
      ['VAT',      draft.contact && draft.contact.vat],
    ];
    const dl = document.createElement('dl');
    rows.forEach(([k, v]) => {
      if (!v) return;
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = String(v);
      dl.appendChild(dt); dl.appendChild(dd);
    });
    wrap.appendChild(dl);

    const actions = document.createElement('div');
    actions.className = 'actions';
    const sendIt = document.createElement('button');
    sendIt.className = 'btn-primary';
    sendIt.innerHTML = '<span class="cart">→</span><span>' + (state.submitting ? t('submit_sending') : t('submit_button')) + '</span>';
    sendIt.disabled = state.submitting;
    sendIt.addEventListener('click', () => submitRequest());
    const editIt = document.createElement('button');
    editIt.className = 'btn-ghost';
    editIt.textContent = t('edit_request');
    editIt.addEventListener('click', () => {
      // Keep the summary on screen (so nothing looks lost) and only hide the buttons;
      // the next bot reply with an updated draft replaces it.
      state.editing = true;
      actions.style.display = 'none';
      // Remove the last bot bubble — it usually said something like
      // "I'm sending this now" or contained the summary text, which is
      // misleading once the customer wants to change something.
      const lastBot = messagesEl.querySelector('.msg.bot:last-of-type');
      if (lastBot) lastBot.remove();
      // Drop a fresh bot-style prompt asking what to change, in the
      // CONVERSATION language (not the UI language).
      addMessage(tChat('edit_prompt'), 'bot');
      inputEl.focus();
    });
    actions.appendChild(sendIt);
    actions.appendChild(editIt);
    wrap.appendChild(actions);

    submitArea.appendChild(wrap);
    wrap.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  function renderSuccess() {
    submitArea.innerHTML = '';
    document.querySelector('.chat-card').style.display = 'none';
    const wrap = document.createElement('div');
    wrap.className = 'success';
    const heading = (t('success_heading') || '').replace(/\s*✓\s*$/, '').trim();
    wrap.innerHTML = '<div class="checkmark">✓</div><h2>' + (heading || 'Request sent') + '</h2><p>' + t('success_body') + '</p>';
    submitArea.appendChild(wrap);
    wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function postJSON(url, payload) {
    let res;
    try {
      res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        credentials: 'same-origin',
      });
    } catch (e) {
      throw { kind: 'network', message: t('err_network') };
    }
    let data = null;
    try { data = await res.json(); } catch (e) {}
    if (!res.ok) {
      const msg = (data && data.error) ? data.error : t('err_generic');
      throw { kind: 'http', status: res.status, message: msg };
    }
    return data || {};
  }

  async function sendMessage(text) {
    if (state.awaitingReply) return;
    addMessage(text, 'user');
    inputEl.value = '';
    autoresize();
    state.awaitingReply = true;
    sendBtn.disabled = true;
    showThinking();

    const honeypot = composer.elements['website'].value;

    try {
      let data;
      if (state.conversationToken === null) {
        data = await postJSON(API.start, {
          message: text,
          honeypot: honeypot,
          page_loaded_at: state.pageLoadedAt,
          page_lang: state.lang,
          lang_pinned: !!state.langPinned,
        });
        state.conversationToken = data.conversation_token;
      } else {
        data = await postJSON(API.chat, {
          conversation_token: state.conversationToken,
          history: state.history,
          message: text,
          page_lang: state.lang,
          lang_pinned: !!state.langPinned,
        });
      }
      hideThinking();
      state.history = data.history || [];
      // Follow the conversation. state.lang starts from the BROWSER (or the URL
      // hash), and used to stay there forever — applyLang() only ever ran on
      // load and on a manual button click. So a Dutch customer typing Dutch got
      // Dutch answers wrapped in English chrome. Whenever the bot tells us the
      // language it detected, move the whole UI to match.
      // The server decides the reply language (page language, or the language the
      // customer clearly switched to). The page follows, so buttons and answers match.
      syncLangToConversation(data.lang);
      // Bot called check_shop_pricing one or more times. Render one card
      // per quote (customer can ask about multiple products in a single
      // message). Falls back to the singular `shop_quote` field for back-
      // compat with older server responses.
      const quotes = (data.shop_quotes && data.shop_quotes.length)
                     ? data.shop_quotes
                     : (data.shop_quote ? [data.shop_quote] : []);
      if (data.assistant && data.assistant.trim()) {
        addMessage(data.assistant, 'bot');
      } else if (quotes.some(q => q && q.ok)) {
        // The bot sometimes sends only the tool call, no text (Kris, 17 Oct):
        // a bare card with nothing above it. Put the standard intro there.
        const ql = (quotes.find(q => q && q.ok) || {}).lang || conversationLang();
        addMessage(((window.I18N[ql] || window.I18N.en).shop_intro) || window.I18N.en.shop_intro, 'bot');
      }
      if (quotes.length) {
        state.lastShopQuote = quotes[quotes.length - 1];
        quotes.forEach(renderShopCard);
      }
      if (data.ready_to_submit && data.draft) {
        state.lastDraft = data.draft;
        renderSubmitPanel(data.draft);
      } else if (!state.editing) {
        submitArea.innerHTML = '';
      }
      // After the first bot reply, surface the skip-and-send option so
      // the customer can bail out of further questions at any time.
      if (state.history.length >= 2) skipRow.classList.add('on');
    } catch (err) {
      hideThinking();
      addError(err.message || t('err_generic'));
    } finally {
      state.awaitingReply = false;
      sendBtn.disabled = false;
      inputEl.focus();
    }
  }

  async function submitRequest() {
    if (state.submitting || !state.lastDraft) return;
    // The team needs a name and a valid email to reply; the server refuses without them.
    const c = state.lastDraft.contact || {};
    const hasMail  = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(c.email || '').trim());
    const hasPhone = String(c.phone || '').replace(/\D/g, '').length >= 8;
    if (!hasMail && !(String(c.name || '').trim() && hasPhone)) {
      addError(t('err_contact'));
      return;
    }
    state.submitting = true;
    renderSubmitPanel(state.lastDraft);
    try {
      await postJSON(API.submit, {
        conversation_token: state.conversationToken,
        history: state.history,
        draft:   state.lastDraft,
      });
      state.submitted = true;
      renderSuccess();
    } catch (err) {
      addError(err.message || t('err_generic'));
      state.submitting = false;
      renderSubmitPanel(state.lastDraft);
    }
  }

  function autoresize() {
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 220) + 'px';
  }
  inputEl.addEventListener('input', autoresize);
  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      composer.requestSubmit();
    }
  });

  composer.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = inputEl.value.trim();
    if (!text) return;
    if (text.length > 4000) { addError(t('err_long_msg')); return; }
    sendMessage(text);
  });

  // Skip → send a "just submit what you have" message in the conversation's
  // language; the bot's customer-led-shortcut rule will pick it up.
  skipBtn.addEventListener('click', () => {
    if (state.awaitingReply) return;
    sendMessage(tChat('skip_message'));
  });

  // ─────────────────────────────────────────────────────────────────────
  // SHOP CARD — rendered when chat.php returns a shop_quote in the response
  // (the bot called the check_shop_pricing tool and the server proxied to
  // calc.php on clickclick.be).
  // ─────────────────────────────────────────────────────────────────────

  function renderShopCard(quote) {
    if (!quote || !quote.ok) return;
    // Card language = whatever the bot passed in the tool call (sticky to
    // the conversation language), then conversation language as a fallback,
    // then English as a last-resort fallback for any missing key.
    const cardLang = quote.lang || conversationLang();
    const tShop = (key) =>
      ((window.I18N[cardLang] || {})[key])
      || ((window.I18N.en || {})[key])
      || key;

    const wrap = document.createElement('div');
    wrap.className = 'shop-card';

    const badge = document.createElement('div');
    badge.className = 'badge';
    badge.textContent = tShop('shop_badge');
    wrap.appendChild(badge);

    const inclVat   = Number(quote.inclVat || 0);
    const euros     = Math.floor(inclVat);
    const cents     = String(Math.round((inclVat - euros) * 100)).padStart(2, '0');
    const priceRow  = document.createElement('div');
    priceRow.className = 'price-row';
    priceRow.innerHTML =
      '<div class="price">€' + euros + '<span class="cents">,' + cents + '</span></div>' +
      '<div class="vat">' + tShop('shop_incl_vat') + '</div>';
    wrap.appendChild(priceRow);

    if (quote.readyDate) {
      const ready = document.createElement('div');
      ready.className = 'ready';
      ready.innerHTML = tShop('shop_ready') + ' <strong>' + quote.readyDate + '</strong>';
      wrap.appendChild(ready);
    }
    // Express is pickup only — always on the card, not left to the bot (Kris, 17 Oct).
    if (quote.express) {
      const pk = document.createElement('div');
      pk.className = 'ready';
      pk.textContent = tShop('shop_express_pickup');
      wrap.appendChild(pk);
    }

    // Holiday closure — fixed line while the holiday mode runs (26 Oct 2026).
    if (quote.holiday && quote.holiday.from) {
      const hol = document.createElement('div');
      hol.className = 'ready';
      hol.textContent = tShop('shop_holiday').replace('{from}', quote.holiday.from).replace('{to}', quote.holiday.to).replace('{back}', quote.holiday.back);
      wrap.appendChild(hol);
    }

    if (quote.summary) {
      const specs = document.createElement('div');
      specs.className = 'specs';
      specs.textContent = quote.summary;
      wrap.appendChild(specs);
    }

    const actions = document.createElement('div');
    actions.className = 'actions';
    const shopBtn = document.createElement('a');
    shopBtn.className = 'btn-shop';
    // No bare-shop fallback. A link without the prefill params drops the
    // customer on the DEFAULT configuration (flyer / MultiArt Silk 130) while
    // the price card above still shows what they actually asked for — they
    // would order the wrong thing believing it was the quote. No deep link,
    // no button. (Found 17 Aug 2026.)
    shopBtn.href = quote.shopUrl || '';
    shopBtn.target = '_blank';
    shopBtn.rel = 'noopener noreferrer';
    shopBtn.textContent = tShop('shop_order_button') + ' →';
    const keepBtn = document.createElement('button');
    keepBtn.type = 'button';
    keepBtn.className = 'btn-shop-secondary';
    keepBtn.textContent = tShop('shop_change_button');
    keepBtn.addEventListener('click', () => {
      wrap.remove();
      inputEl.focus();
    });
    if (quote.shopUrl) actions.appendChild(shopBtn);
    actions.appendChild(keepBtn);
    wrap.appendChild(actions);

    messagesEl.appendChild(wrap);
    wrap.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  function conversationLang() {
    return (state.lastDraft && state.lastDraft.detected_language) || state.lang;
  }

  inputEl.focus();
})();
</script>
</body>
</html>
