# /chat-api/ — server-side endpoints for the Click Click chatbot.
# The clickclick.be root only 301s to the marketing site (no WordPress), so
# there is nothing to opt out of — but keep rewriting off here anyway so the
# endpoints are never touched by a root rule added later.
RewriteEngine Off
Options -Indexes

# Deny direct HTTP access to secrets, the lib/ folder, and runtime state.
# These should only ever be loaded by PHP from within this directory.
<FilesMatch "^(secrets\.php|secrets\.example\.php|system_prompt\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^lib/        - [F,L]
    RewriteRule ^logs/       - [F,L]
    RewriteRule ^requests/   - [F,L]
    RewriteRule ^\.ratelimit/ - [F,L]
</IfModule>

# Security headers — same shape as calculator/.htaccess.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options        "DENY"
    Header set Referrer-Policy        "strict-origin-when-cross-origin"
</IfModule>

# ─── Whole-API password gate: ON (closed 19 Aug 2026, with /chat/) ───
# Gating the /chat/ UI alone does NOT close the bot: chat.php, start.php and
# submit.php are what the browser posts to, so anyone could drive the assistant
# (and the Anthropic spend, and the mail it sends) straight from curl.
#
# Safe for the UI because chat/index.html fetches with credentials:'same-origin',
# so the browser replays the Basic credentials it already holds for /chat/.
# Delete this block to reopen the API when the chat goes public again.
AuthType Basic
AuthName "Click Click — Chat preview"
AuthUserFile /home/clients/bb59b9bb68f9d5f0bbd421f23f3ae8ed/.htpasswd-ccg
Require valid-user

# Gate cron endpoints (cleanup.php, retention.php) behind Basic Auth so a
# random visitor can't trigger them.
<FilesMatch "^(cleanup|retention)\.php$">
    AuthType Basic
    # Realm text doubles as a deploy fingerprint: it is visible in the
    # WWW-Authenticate header, so an anonymous curl -I proves whether THIS
    # version of the file is the one Apache is actually reading.
    AuthName "Click Click chat cron v2"
    # Reuses the SAME .htpasswd as /flyers/ and /calculator/ — one credential
    # for the whole estate, and no password file needs to exist in this folder.
    #
    # NB: Apache sends the 401 challenge from AuthType alone, and only opens
    # this file when validating a password that was actually submitted. So a
    # 401 to an anonymous request proves NOTHING about this path — a wrong path
    # surfaces as a 500 *after* you type the password. (Learned 17 Aug 2026:
    # this pointed at chat-api/.htpasswd, which was never uploaded.)
    AuthUserFile /home/clients/bb59b9bb68f9d5f0bbd421f23f3ae8ed/.htpasswd-ccg
    Require valid-user
</FilesMatch>

<FilesMatch "^\.htpasswd$">
    Require all denied
</FilesMatch>
