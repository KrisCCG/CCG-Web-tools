# ── NEVER commit these ──
# Real config with Anthropic API key + HMAC signing key
chat-api/secrets.php

# FTP password lives here in plain text (VS Code SFTP extension)
.vscode/sftp.json

# Basic-auth credentials
chat-api/.htpasswd
chat/.htpasswd

# ── Runtime data (PII / state) ──
# Persisted customer Requests — contains contact info, files, transcripts
chat-api/requests/*
!chat-api/requests/.htaccess

# Audit logs — PII-redacted but still sensitive
chat-api/logs/*
!chat-api/logs/.htaccess

# Per-IP rate-limit buckets
chat-api/.ratelimit/*
!chat-api/.ratelimit/.htaccess

# ── macOS / IDE noise ──
.DS_Store
.idea/

# ── Node noise (in case anyone npm installs here by mistake) ──
node_modules/
