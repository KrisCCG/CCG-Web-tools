# Stop WordPress from intercepting requests inside /print-calculator/
RewriteEngine Off
DirectoryIndex index.html
Options -Indexes

# ─── Internal only. This tool shows cost prices and margins. ───
# Same realm string AND same .htpasswd as /calculator/print.html, which this
# page iframes. Browsers scope Basic-auth credentials by origin + realm, so
# matching them means ONE prompt instead of two — previously the wrapper asked
# under "private preview" and the iframe asked again under "dashboard".
# The old print-calculator/.htpasswd was byte-identical to the flyers one and
# can be deleted from the server.
AuthType Basic
AuthName "Click Click — dashboard"
AuthUserFile /home/clients/bb59b9bb68f9d5f0bbd421f23f3ae8ed/.htpasswd-ccg
Require valid-user

# ── Security headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self' https://clickclick.be https://*.clickclick.be"
</IfModule>
