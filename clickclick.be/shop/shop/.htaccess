# Stop WordPress from intercepting requests inside /shop/
# (standard WP root .htaccess would otherwise route everything to index.php)
DirectoryIndex index.html
Options -Indexes

# ─── Maintenance switch ───
# While the file maintenance.on exists in the clickclick.be root, everyone gets
# /shop/maintenance.html with status 503. WordPress creates/removes that file when
# "Maintenance mode" is ticked in Settings → General. You can also create or delete
# it by hand over SFTP. The password gate below still applies first.
RewriteEngine On
RewriteCond /home/clients/bb59b9bb68f9d5f0bbd421f23f3ae8ed/sites/clickclick.be/maintenance.on -f
RewriteCond %{REQUEST_URI} !/maintenance\.html$
RewriteRule ^ - [R=503,L]
ErrorDocument 503 /shop/maintenance.html

# ─── TEMP: Password gate while Mollie is in test mode ───
# Remove these 4 lines when going live. AuthUserFile is an absolute path on the
# Infomaniak host — adjust if the remote shows a different site root.
AuthType Basic
AuthName "Click Click — private preview"
AuthUserFile /home/clients/bb59b9bb68f9d5f0bbd421f23f3ae8ed/.htpasswd-ccg
Require valid-user

# Correct MIME types
AddType application/javascript                                                 .js
AddType font/woff2 .woff2
AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet      .xlsx

# Light caching — HTML always fresh, static assets can hang around
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html            "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 hour"

  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType image/png            "access plus 7 days"
  ExpiresByType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet "access plus 10 minutes"
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────
# CSP notes:
#  - 'unsafe-inline' on script-src is needed because the single-page app keeps
#    its JS inline in index.html. Tightening (extract to app.js + nonce) is a
#    follow-up.
#  - 'unsafe-inline' on style-src covers the many inline <style> blocks.
#  - fonts are self-hosted (fonts/*.woff2) since 18 Aug 2026 — nothing external.
#  - connect-src 'self' covers /calculator/csrf.php + upload.php + calc.php.
#  - frame-ancestors keeps the WordPress iframe wrapping working at clickclick.be.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://images.squarespace-cdn.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self' https://clickclick.be https://*.clickclick.be"
</IfModule>
