# Stop WordPress from intercepting requests inside /tools/
RewriteEngine Off
DirectoryIndex index.html
AddType font/woff2 .woff2

# The hub is a list of links that changes whenever the estate does — never let a
# browser hold a stale copy. Fonts are immutable, so they cache hard.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html   "access plus 0 seconds"
  ExpiresByType font/woff2  "access plus 1 year"
  ExpiresByType font/woff   "access plus 1 year"
</IfModule>
Options -Indexes

# ─── Internal-only password gate ───────────────────────────────────────────
# Reuses the SAME login as /flyers/ (no new .htpasswd needed).
# AuthUserFile MUST be the absolute path on the Infomaniak host — if the remote
# site root differs, copy the exact path from flyers/.htaccess line 12.
AuthType Basic
AuthName "Click Click — internal tools"
AuthUserFile /home/clients/bb59b9bb68f9d5f0bbd421f23f3ae8ed/.htpasswd-ccg
Require valid-user

# Don't let search engines index the hub
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
