# /calculator/orders/ — contains customer PII (order JSONs with names, emails,
# addresses, VAT numbers) AND uploaded artwork files. Block direct HTTP access.
# PHP can still read these files server-side via file_get_contents / fopen.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

Options -Indexes
