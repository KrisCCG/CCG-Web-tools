# /calculator/data/ — contains pricing secrets (raw paper costs, margins, tiers).
# Block direct HTTP access. PHP can still read these files server-side via require / fopen.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

Options -Indexes
